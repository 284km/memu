// gb_cpu_instrs.mere — the complete Sharp LR35902 core, validated against
// Blargg's cpu_instrs test ROMs (the de-facto Game Boy CPU conformance suite).
//
// Unlike the compact ../gameboy.mere teaching rung, this implements the full
// instruction set: the whole LD and ALU blocks, 16-bit arithmetic (ADD HL/SP,
// LD HL,SP+r8), the accumulator rotates, DAA / CPL / SCF / CCF, the complete
// CB-prefix table (RLC/RRC/RL/RR/SLA/SRA/SWAP/SRL + BIT/RES/SET), RST, RETI,
// EI/DI, PUSH/POP AF via the packed F register, and the high-RAM / (nn)
// loads. It maps a 32 KB test ROM flat at $0000 (ROM-area writes — MBC
// registers — are ignored), starts at $0100 with post-boot register values,
// captures the serial port ($FF01/$FF02) where Blargg prints results, and
// stops when the program counter self-loops.
//
// Result: the ten CPU-instruction test ROMs (01, 03-11) all print "Passed" on
// the interpreter, C, and LLVM backends. 02-interrupts is out of scope — it
// exercises the interrupt/timer hardware (IME/IE/IF + the timer), not
// instruction semantics; HALT is treated as a NOP and no interrupts fire.
//
// The ROMs are not redistributed here — see blargg/README.md to fetch them.

let mask8  = fn x -> bit_and x 255;
let mask16 = fn x -> bit_and x 65535;
let hi8 = fn x -> bit_and (bit_shr x 8) 255;
let lo8 = fn x -> bit_and x 255;
let new_vec = fn n -> fn x ->
  let v = vec_new () in
  let rec go = fn i -> if i >= n then () else let _ = vec_push v x in go (i + 1) in
  let _ = go 0 in v;

// reg: [A B C D E H L SP PC  Z N H C  IME HALT]
let rA=0; let rB=1; let rC=2; let rD=3; let rE=4; let rH=5; let rL=6;
let rSP=7; let rPC=8; let fZ=9; let fN=10; let fH=11; let fC=12; let rIME=13; let rHALT=14;

// memory: ROM area ($0000-$7FFF) is read-only (ignore writes = MBC regs)
let rd = fn mem -> fn a -> vec_get mem (mask16 a);
let wr = fn mem -> fn a -> fn v ->
  let addr = mask16 a in
  if addr < 0x8000 then () else vec_set mem addr (mask8 v);

let fetch = fn mem -> fn reg ->
  let pc = vec_get reg rPC in let b = vec_get mem pc in
  let _ = vec_set reg rPC (mask16 (pc + 1)) in b;
let fetch16 = fn mem -> fn reg -> let l = fetch mem reg in let h = fetch mem reg in l + h * 256;

let get_hl = fn reg -> vec_get reg rH * 256 + vec_get reg rL;
let get_bc = fn reg -> vec_get reg rB * 256 + vec_get reg rC;
let get_de = fn reg -> vec_get reg rD * 256 + vec_get reg rE;
let set_hl = fn reg -> fn v -> let _ = vec_set reg rH (hi8 v) in vec_set reg rL (lo8 v);
let set_bc = fn reg -> fn v -> let _ = vec_set reg rB (hi8 v) in vec_set reg rC (lo8 v);
let set_de = fn reg -> fn v -> let _ = vec_set reg rD (hi8 v) in vec_set reg rE (lo8 v);

// packed F register (for PUSH/POP AF): Z N H C in the high nibble
let pack_f = fn reg ->
  bit_or (bit_shl (vec_get reg fZ) 7) (bit_or (bit_shl (vec_get reg fN) 6)
  (bit_or (bit_shl (vec_get reg fH) 5) (bit_shl (vec_get reg fC) 4)));
let unpack_f = fn reg -> fn f ->
  let _ = vec_set reg fZ (bit_and (bit_shr f 7) 1) in
  let _ = vec_set reg fN (bit_and (bit_shr f 6) 1) in
  let _ = vec_set reg fH (bit_and (bit_shr f 5) 1) in
  vec_set reg fC (bit_and (bit_shr f 4) 1);

// opcode reg idx 0..7 = B C D E H L (HL) A
let get_r = fn mem -> fn reg -> fn idx ->
  if idx == 0 then vec_get reg rB else if idx == 1 then vec_get reg rC
  else if idx == 2 then vec_get reg rD else if idx == 3 then vec_get reg rE
  else if idx == 4 then vec_get reg rH else if idx == 5 then vec_get reg rL
  else if idx == 6 then rd mem (get_hl reg) else vec_get reg rA;
let set_r = fn mem -> fn reg -> fn idx -> fn val ->
  let v = mask8 val in
  if idx == 0 then vec_set reg rB v else if idx == 1 then vec_set reg rC v
  else if idx == 2 then vec_set reg rD v else if idx == 3 then vec_set reg rE v
  else if idx == 4 then vec_set reg rH v else if idx == 5 then vec_set reg rL v
  else if idx == 6 then wr mem (get_hl reg) v else vec_set reg rA v;

let set_flags = fn reg -> fn z -> fn n -> fn h -> fn c ->
  let _ = vec_set reg fZ z in let _ = vec_set reg fN n in
  let _ = vec_set reg fH h in vec_set reg fC c;

let push16 = fn mem -> fn reg -> fn v ->
  let sp = mask16 (vec_get reg rSP - 2) in
  let _ = vec_set reg rSP sp in
  let _ = wr mem sp (lo8 v) in wr mem (mask16 (sp + 1)) (hi8 v);
let pop16 = fn mem -> fn reg ->
  let sp = vec_get reg rSP in
  let r = rd mem sp + rd mem (mask16 (sp + 1)) * 256 in
  let _ = vec_set reg rSP (mask16 (sp + 2)) in r;

// A-register ALU (0..7 = ADD ADC SUB SBC AND XOR OR CP), GB half-carry
let alu = fn reg -> fn sub -> fn m ->
  let a = vec_get reg rA in let c0 = vec_get reg fC in
  if sub == 0 || sub == 1 then
    let carry = if sub == 1 then c0 else 0 in
    let r = a + m + carry in
    let h = if bit_and a 15 + bit_and m 15 + carry > 15 then 1 else 0 in
    let rr = mask8 r in
    let _ = set_flags reg (if rr == 0 then 1 else 0) 0 h (if r > 255 then 1 else 0) in
    vec_set reg rA rr
  else if sub == 2 || sub == 3 || sub == 7 then
    let carry = if sub == 3 then c0 else 0 in
    let r = a - m - carry in
    let h = if bit_and a 15 - bit_and m 15 - carry < 0 then 1 else 0 in
    let rr = mask8 r in
    let _ = set_flags reg (if rr == 0 then 1 else 0) 1 h (if r < 0 then 1 else 0) in
    if sub == 7 then () else vec_set reg rA rr
  else if sub == 4 then
    let rr = bit_and a m in
    let _ = set_flags reg (if rr == 0 then 1 else 0) 0 1 0 in vec_set reg rA rr
  else if sub == 5 then
    let rr = bit_xor a m in
    let _ = set_flags reg (if rr == 0 then 1 else 0) 0 0 0 in vec_set reg rA rr
  else
    let rr = bit_or a m in
    let _ = set_flags reg (if rr == 0 then 1 else 0) 0 0 0 in vec_set reg rA rr;

let inc_r = fn mem -> fn reg -> fn idx ->
  let v = get_r mem reg idx in let r = mask8 (v + 1) in
  let _ = set_r mem reg idx r in
  let _ = vec_set reg fZ (if r == 0 then 1 else 0) in
  let _ = vec_set reg fN 0 in
  vec_set reg fH (if bit_and v 15 == 15 then 1 else 0);
let dec_r = fn mem -> fn reg -> fn idx ->
  let v = get_r mem reg idx in let r = mask8 (v - 1) in
  let _ = set_r mem reg idx r in
  let _ = vec_set reg fZ (if r == 0 then 1 else 0) in
  let _ = vec_set reg fN 1 in
  vec_set reg fH (if bit_and v 15 == 0 then 1 else 0);

let add_hl = fn reg -> fn rr ->
  let hl = get_hl reg in let r = hl + rr in
  let _ = vec_set reg fN 0 in
  let _ = vec_set reg fH (if bit_and hl 4095 + bit_and rr 4095 > 4095 then 1 else 0) in
  let _ = vec_set reg fC (if r > 65535 then 1 else 0) in
  set_hl reg (mask16 r);

let get_pair = fn reg -> fn p ->
  if p == 0 then get_bc reg else if p == 1 then get_de reg
  else if p == 2 then get_hl reg else vec_get reg rSP;
let set_pair = fn reg -> fn p -> fn v ->
  if p == 0 then set_bc reg v else if p == 1 then set_de reg v
  else if p == 2 then set_hl reg v else vec_set reg rSP (mask16 v);

let cond = fn reg -> fn cc ->
  if cc == 0 then (if vec_get reg fZ == 0 then 1 else 0)
  else if cc == 1 then vec_get reg fZ
  else if cc == 2 then (if vec_get reg fC == 0 then 1 else 0)
  else vec_get reg fC;

// DAA — the classic. Adjusts A into BCD after an add/sub.
let daa = fn reg ->
  let a0 = vec_get reg rA in
  let n = vec_get reg fN in let h = vec_get reg fH in let c = vec_get reg fC in
  if n == 0 then
    let c1 = if c == 1 || a0 > 0x99 then 1 else 0 in
    let a1 = if c1 == 1 then a0 + 0x60 else a0 in
    let a2 = if h == 1 || bit_and a1 15 > 0x09 then a1 + 0x06 else a1 in
    let r = mask8 a2 in
    let _ = vec_set reg rA r in
    let _ = vec_set reg fZ (if r == 0 then 1 else 0) in
    let _ = vec_set reg fH 0 in vec_set reg fC c1
  else
    let a1 = if c == 1 then a0 - 0x60 else a0 in
    let a2 = if h == 1 then a1 - 0x06 else a1 in
    let r = mask8 a2 in
    let _ = vec_set reg rA r in
    let _ = vec_set reg fZ (if r == 0 then 1 else 0) in
    vec_set reg fH 0;   // C left unchanged on subtract path

// CB rotate/shift on a value (returns result; sets flags per op)
let cb_rot = fn reg -> fn n -> fn v ->
  if n == 0 then                                   // RLC
    let c = bit_shr v 7 in let r = mask8 (bit_or (bit_shl v 1) c) in
    let _ = set_flags reg (if r == 0 then 1 else 0) 0 0 c in r
  else if n == 1 then                              // RRC
    let c = bit_and v 1 in let r = bit_or (bit_shr v 1) (bit_shl c 7) in
    let _ = set_flags reg (if r == 0 then 1 else 0) 0 0 c in r
  else if n == 2 then                              // RL
    let c = bit_shr v 7 in let r = mask8 (bit_or (bit_shl v 1) (vec_get reg fC)) in
    let _ = set_flags reg (if r == 0 then 1 else 0) 0 0 c in r
  else if n == 3 then                              // RR
    let c = bit_and v 1 in let r = bit_or (bit_shr v 1) (bit_shl (vec_get reg fC) 7) in
    let _ = set_flags reg (if r == 0 then 1 else 0) 0 0 c in r
  else if n == 4 then                              // SLA
    let c = bit_shr v 7 in let r = mask8 (bit_shl v 1) in
    let _ = set_flags reg (if r == 0 then 1 else 0) 0 0 c in r
  else if n == 5 then                              // SRA (arith)
    let c = bit_and v 1 in let r = bit_or (bit_shr v 1) (bit_and v 128) in
    let _ = set_flags reg (if r == 0 then 1 else 0) 0 0 c in r
  else if n == 6 then                              // SWAP
    let r = bit_or (bit_shr v 4) (mask8 (bit_shl v 4)) in
    let _ = set_flags reg (if r == 0 then 1 else 0) 0 0 0 in r
  else                                             // SRL
    let c = bit_and v 1 in let r = bit_shr v 1 in
    let _ = set_flags reg (if r == 0 then 1 else 0) 0 0 c in r;

let cb = fn mem -> fn reg ->
  let op = fetch mem reg in
  let grp = bit_shr op 6 in
  let bitn = bit_and (bit_shr op 3) 7 in
  let idx = bit_and op 7 in
  let v = get_r mem reg idx in
  if grp == 0 then set_r mem reg idx (cb_rot reg bitn v)          // rot/shift/swap
  else if grp == 1 then                                          // BIT
    let _ = vec_set reg fZ (if bit_and v (bit_shl 1 bitn) == 0 then 1 else 0) in
    let _ = vec_set reg fN 0 in vec_set reg fH 1
  else if grp == 2 then set_r mem reg idx (bit_and v (bit_xor (bit_shl 1 bitn) 255))  // RES
  else set_r mem reg idx (bit_or v (bit_shl 1 bitn));            // SET

let step = fn mem -> fn reg ->
  let op = fetch mem reg in
  if op == 0x00 then ()                                                  // NOP
  else if op == 0x76 then ()                                             // HALT -> treat as NOP (no IRQs here)
  else if op == 0x10 then let _ = fetch mem reg in ()                    // STOP (skip operand byte)
  else if op == 0xF3 then vec_set reg rIME 0                             // DI
  else if op == 0xFB then vec_set reg rIME 1                             // EI
  else if op == 0xCB then cb mem reg
  // 16-bit immediate loads
  else if op == 0x01 then set_bc reg (fetch16 mem reg)
  else if op == 0x11 then set_de reg (fetch16 mem reg)
  else if op == 0x21 then set_hl reg (fetch16 mem reg)
  else if op == 0x31 then vec_set reg rSP (fetch16 mem reg)
  // LD (nn),SP
  else if op == 0x08 then let a = fetch16 mem reg in let sp = vec_get reg rSP in
    let _ = wr mem a (lo8 sp) in wr mem (mask16 (a + 1)) (hi8 sp)
  // indirect A loads/stores + HL inc/dec
  else if op == 0x02 then wr mem (get_bc reg) (vec_get reg rA)
  else if op == 0x12 then wr mem (get_de reg) (vec_get reg rA)
  else if op == 0x0A then vec_set reg rA (rd mem (get_bc reg))
  else if op == 0x1A then vec_set reg rA (rd mem (get_de reg))
  else if op == 0x22 then let a = get_hl reg in let _ = wr mem a (vec_get reg rA) in set_hl reg (mask16 (a + 1))
  else if op == 0x32 then let a = get_hl reg in let _ = wr mem a (vec_get reg rA) in set_hl reg (mask16 (a - 1))
  else if op == 0x2A then let a = get_hl reg in let _ = vec_set reg rA (rd mem a) in set_hl reg (mask16 (a + 1))
  else if op == 0x3A then let a = get_hl reg in let _ = vec_set reg rA (rd mem a) in set_hl reg (mask16 (a - 1))
  // high loads
  else if op == 0xE0 then wr mem (0xFF00 + fetch mem reg) (vec_get reg rA)         // LDH (n),A
  else if op == 0xF0 then vec_set reg rA (rd mem (0xFF00 + fetch mem reg))         // LDH A,(n)
  else if op == 0xE2 then wr mem (0xFF00 + vec_get reg rC) (vec_get reg rA)        // LD (C),A
  else if op == 0xF2 then vec_set reg rA (rd mem (0xFF00 + vec_get reg rC))        // LD A,(C)
  else if op == 0xEA then wr mem (fetch16 mem reg) (vec_get reg rA)                // LD (nn),A
  else if op == 0xFA then vec_set reg rA (rd mem (fetch16 mem reg))                // LD A,(nn)
  // INC/DEC 16-bit
  else if op == 0x03 || op == 0x13 || op == 0x23 || op == 0x33 then
    let p = bit_and (bit_shr op 4) 3 in set_pair reg p (mask16 (get_pair reg p + 1))
  else if op == 0x0B || op == 0x1B || op == 0x2B || op == 0x3B then
    let p = bit_and (bit_shr op 4) 3 in set_pair reg p (mask16 (get_pair reg p - 1))
  else if op == 0x09 || op == 0x19 || op == 0x29 || op == 0x39 then
    add_hl reg (get_pair reg (bit_and (bit_shr op 4) 3))
  // SP arithmetic
  else if op == 0xE8 then                                                          // ADD SP,r8
    let sp = vec_get reg rSP in let rel = fetch mem reg in
    let off = if rel >= 128 then rel - 256 else rel in
    let _ = vec_set reg fZ 0 in let _ = vec_set reg fN 0 in
    let _ = vec_set reg fH (if bit_and sp 15 + bit_and rel 15 > 15 then 1 else 0) in
    let _ = vec_set reg fC (if bit_and sp 255 + bit_and rel 255 > 255 then 1 else 0) in
    vec_set reg rSP (mask16 (sp + off))
  else if op == 0xF8 then                                                          // LD HL,SP+r8
    let sp = vec_get reg rSP in let rel = fetch mem reg in
    let off = if rel >= 128 then rel - 256 else rel in
    let _ = vec_set reg fZ 0 in let _ = vec_set reg fN 0 in
    let _ = vec_set reg fH (if bit_and sp 15 + bit_and rel 15 > 15 then 1 else 0) in
    let _ = vec_set reg fC (if bit_and sp 255 + bit_and rel 255 > 255 then 1 else 0) in
    set_hl reg (mask16 (sp + off))
  else if op == 0xF9 then vec_set reg rSP (get_hl reg)                             // LD SP,HL
  // INC/DEC 8-bit: 00 ddd 100 / 101
  else if op < 0x40 && bit_and op 7 == 4 then inc_r mem reg (bit_and (bit_shr op 3) 7)
  else if op < 0x40 && bit_and op 7 == 5 then dec_r mem reg (bit_and (bit_shr op 3) 7)
  // LD r,n
  else if op < 0x40 && bit_and op 7 == 6 then set_r mem reg (bit_and (bit_shr op 3) 7) (fetch mem reg)
  // accumulator rotates
  else if op == 0x07 then let a = vec_get reg rA in let c = bit_shr a 7 in
    let _ = vec_set reg rA (mask8 (bit_or (bit_shl a 1) c)) in set_flags reg 0 0 0 c   // RLCA
  else if op == 0x0F then let a = vec_get reg rA in let c = bit_and a 1 in
    let _ = vec_set reg rA (bit_or (bit_shr a 1) (bit_shl c 7)) in set_flags reg 0 0 0 c  // RRCA
  else if op == 0x17 then let a = vec_get reg rA in let c = bit_shr a 7 in
    let _ = vec_set reg rA (mask8 (bit_or (bit_shl a 1) (vec_get reg fC))) in set_flags reg 0 0 0 c  // RLA
  else if op == 0x1F then let a = vec_get reg rA in let c = bit_and a 1 in
    let _ = vec_set reg rA (bit_or (bit_shr a 1) (bit_shl (vec_get reg fC) 7)) in set_flags reg 0 0 0 c  // RRA
  // DAA / CPL / SCF / CCF
  else if op == 0x27 then daa reg
  else if op == 0x2F then let _ = vec_set reg rA (bit_and (bit_xor (vec_get reg rA) 255) 255) in
    let _ = vec_set reg fN 1 in vec_set reg fH 1                                     // CPL
  else if op == 0x37 then let _ = vec_set reg fN 0 in let _ = vec_set reg fH 0 in vec_set reg fC 1  // SCF
  else if op == 0x3F then let _ = vec_set reg fN 0 in let _ = vec_set reg fH 0 in
    vec_set reg fC (if vec_get reg fC == 0 then 1 else 0)                            // CCF
  // LD r,r' block (0x40-0x7F except 0x76)
  else if op >= 0x40 && op <= 0x7F then
    set_r mem reg (bit_and (bit_shr op 3) 7) (get_r mem reg (bit_and op 7))
  // ALU block 0x80-0xBF
  else if op >= 0x80 && op <= 0xBF then
    alu reg (bit_and (bit_shr op 3) 7) (get_r mem reg (bit_and op 7))
  // ALU A,n immediate: 11 ooo 110
  else if op == 0xC6 || op == 0xCE || op == 0xD6 || op == 0xDE
       || op == 0xE6 || op == 0xEE || op == 0xF6 || op == 0xFE then
    alu reg (bit_and (bit_shr op 3) 7) (fetch mem reg)
  // jumps
  else if op == 0xC3 then vec_set reg rPC (fetch16 mem reg)
  else if op == 0xC2 || op == 0xCA || op == 0xD2 || op == 0xDA then
    let t = fetch16 mem reg in if cond reg (bit_and (bit_shr op 3) 3) == 1 then vec_set reg rPC t else ()
  else if op == 0xE9 then vec_set reg rPC (get_hl reg)                              // JP (HL)
  else if op == 0x18 then let rel = fetch mem reg in
    let off = if rel >= 128 then rel - 256 else rel in vec_set reg rPC (mask16 (vec_get reg rPC + off))
  else if op == 0x20 || op == 0x28 || op == 0x30 || op == 0x38 then
    let rel = fetch mem reg in
    if cond reg (bit_and (bit_shr op 3) 3) == 1 then
      let off = if rel >= 128 then rel - 256 else rel in vec_set reg rPC (mask16 (vec_get reg rPC + off))
    else ()
  // calls / returns
  else if op == 0xCD then let t = fetch16 mem reg in let _ = push16 mem reg (vec_get reg rPC) in vec_set reg rPC t
  else if op == 0xC4 || op == 0xCC || op == 0xD4 || op == 0xDC then
    let t = fetch16 mem reg in
    if cond reg (bit_and (bit_shr op 3) 3) == 1 then let _ = push16 mem reg (vec_get reg rPC) in vec_set reg rPC t else ()
  else if op == 0xC9 then vec_set reg rPC (pop16 mem reg)                           // RET
  else if op == 0xD9 then let _ = vec_set reg rIME 1 in vec_set reg rPC (pop16 mem reg)  // RETI
  else if op == 0xC0 || op == 0xC8 || op == 0xD0 || op == 0xD8 then
    if cond reg (bit_and (bit_shr op 3) 3) == 1 then vec_set reg rPC (pop16 mem reg) else ()
  // RST
  else if op == 0xC7 || op == 0xCF || op == 0xD7 || op == 0xDF
       || op == 0xE7 || op == 0xEF || op == 0xF7 || op == 0xFF then
    let _ = push16 mem reg (vec_get reg rPC) in vec_set reg rPC (bit_and op 0x38)
  // push / pop (incl AF)
  else if op == 0xC5 then push16 mem reg (get_bc reg)
  else if op == 0xD5 then push16 mem reg (get_de reg)
  else if op == 0xE5 then push16 mem reg (get_hl reg)
  else if op == 0xF5 then push16 mem reg (vec_get reg rA * 256 + pack_f reg)        // PUSH AF
  else if op == 0xC1 then set_bc reg (pop16 mem reg)
  else if op == 0xD1 then set_de reg (pop16 mem reg)
  else if op == 0xE1 then set_hl reg (pop16 mem reg)
  else if op == 0xF1 then let v = pop16 mem reg in                                  // POP AF
    let _ = vec_set reg rA (hi8 v) in unpack_f reg (bit_and v 0xF0)
  else vec_set reg rHALT 1;                                                         // unknown -> halt

// run: step, capture serial ($FF02 bit7 => emit $FF01 into ser), stop on PC self-loop
let mem = new_vec 65536 0;
let reg = new_vec 15 0;
let ser = vec_new ();
let rom = read_file_bytes "rom.gb";
let romn = vec_len rom;
let rec load_rom = fn i -> if i >= romn then () else let _ = vec_set mem i (vec_get rom i) in load_rom (i + 1);
let _ = load_rom 0;
// power-up-ish state used by Blargg (post-boot register values)
let _ = vec_set reg rA 0x01;
let _ = set_bc reg 0x0013;
let _ = set_de reg 0x00D8;
let _ = set_hl reg 0x014D;
let _ = vec_set reg rSP 0xFFFE;
let _ = vec_set reg rPC 0x0100;
let _ = set_flags reg 1 0 1 1;      // F = 0xB0
let _ = vec_set mem 0xFF44 0x90;    // LY: stub a stable "vblank" scanline so LY-polling loops exit

let rec drive = fn budget ->
  if budget <= 0 then 0 - 1
  else
    let before = vec_get reg rPC in
    let _ = step mem reg in
    let _ =
      if bit_and (vec_get mem 0xFF02) 128 == 0 then ()
      else let _ = vec_push ser (vec_get mem 0xFF01) in vec_set mem 0xFF02 0 in
    if vec_get reg rHALT == 1 then 0 - 2
    else if vec_get reg rPC == before then before
    else drive (budget - 1);

let trap = drive 300000000;
// print the captured serial text
let sbuf = strbuf_new ();
let n = vec_len ser;
let rec emit = fn i -> if i >= n then () else let _ = strbuf_push sbuf (chr (vec_get ser i)) in emit (i + 1);
let _ = emit 0;
let _ = print (strbuf_to_str sbuf);
let _ = print ("trap_pc=" ++ str_of_int trap);
0
