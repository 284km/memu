// rv32i_run.mere — the RV32IM core (see ../riscv.mere for the base RV32I rung)
// running REAL, compiled software. It loads a flat binary (objcopy'd from a
// freestanding RV32I(M) ELF that gcc produced from hello.c / app.c), starts at
// _start (PC=0), and services a tiny syscall ABI on `ecall`:  a7=64
// write(fd, buf, len) -> stdout, a7=93 exit(code) -> halt. So a normal C
// program runs on a CPU written in Mere and its output comes back out. Same
// result on the interpreter, C, and LLVM backends.
//
// Instructions: the full RV32I integer set (LUI, AUIPC, JAL, JALR, the branch
// set, all loads/stores LB/LBU/LH/LHU/LW + SB/SH/SW, the I-type and R-type ALU
// ops, ECALL, FENCE as a nop) plus the RV32M multiply/divide extension (MUL,
// MULH/MULHSU/MULHU, DIV/DIVU, REM/REMU) — gcc lowers `/` and `%` by a constant
// to a MULHU, so real -O2 code needs M. No CSRs, traps, or A/F extensions.
// Memory is a flat 512 KB byte array; the program loads at address 0 and the
// stack starts near the top.

let mask32 = fn x -> bit_and x 4294967295;                 // 0xFFFFFFFF
// interpret a 32-bit value as signed two's complement
let signed32 = fn x ->
  let m = mask32 x in
  if bit_and m 2147483648 == 0 then m else m - 4294967296; // 0x80000000 / 2^32
// sign-extend a `bits`-wide value already confined to `bits` bits
let sign_ext = fn v -> fn bits ->
  let half = bit_shl 1 (bits - 1) in
  if bit_and v half == 0 then v else v - bit_shl 1 bits;
// arithmetic right shift of a 32-bit value by s (0..31)
let sra32 = fn v -> fn s ->
  let m = mask32 v in
  let r = bit_shr m s in
  if bit_and m 2147483648 == 0 || s == 0 then mask32 r
  else mask32 (bit_or r (bit_shl 4294967295 (32 - s)));

let new_vec = fn n -> fn x ->
  let v = vec_new () in
  let rec go = fn i -> if i >= n then () else let _ = vec_push v x in go (i + 1) in
  let _ = go 0 in v;

// Why the machine stopped. Every halt used to be `vec_set st 1 1` and said
// nothing, so a guest that stopped on its first unimplemented instruction looked
// exactly like one that ran to completion and printed nothing -- which is what a
// 4 MB guest did, and there was no way to tell the two apart from the outside.
let halt_exit = 1;        // the guest asked to exit
let halt_trap = 2;        // a trap with no handler installed
let halt_mulh = 3;        // MULH / MULHSU / MULHU, which this core does not have
let halt_finisher = 4;    // a write to QEMU virt's test finisher
let halt_crossed = 5;     // `trace`: the guest's heap top reached its stack
let halt = fn st -> fn (why: int) -> let _ = vec_set st 2 why in vec_set st 1 1;

// --- where RAM is ---------------------------------------------------------
// Address 0 by default: this backend's own layout, code from 0 and devices
// above it. Pass `virt` as the second argument for QEMU's virt board, where
// DRAM starts at 2 GB and every device sits below it — so an image built with
// `mere -rv --load-base 0x80000000` runs *here* as well as on QEMU, and the
// two can be diffed against each other.
//
// The addresses inside the core stay absolute, exactly as the guest computes
// them; only these four accessors know where RAM landed.
let virt = match args () with
  | Cons (_, Cons (b, _)) -> if str_eq b "virt" then 1 else 0
  | _ -> 0;
let dram_base = if virt == 1 then 2147483648 else 0;      // 0x80000000

// --- little-endian byte memory ------------------------------------------
// Stores that put a STACK-RANGE VALUE at a HEAP-RANGE ADDRESS, last 8, dumped on
// an abnormal halt. Heap data corrupted with frame addresses is this exact
// signature, and the trap that finally reports it is thousands of instructions
// downstream of the store that did it. try_or records legitimately match (they
// hold sp and fp), so the pc column is what separates the suspect from them.
// Defined here, before `step`, because top-level order is visibility; armed
// where `trace` is parsed.
let swon = new_vec 1 0;
// An exact-address store watch: every store that hits [watch, watch+4) prints
// the pc and the value, as it happens. `./rvrun <ram> watch <addr> ...`
let watch_addr = new_vec 1 0;
let swring = new_vec 24 0;    // 8 x (pc, addr, val)
let swi = new_vec 1 0;
let sw_hi = 33554432;          // heap range: below this RAM's midpoint
let stack_lo = 58720256;       // values in the top ~8MB of a 64MB machine

let ldb = fn mem -> fn a -> vec_get mem (a - dram_base);
let stb = fn mem -> fn a -> fn v -> vec_set mem (a - dram_base) (bit_and v 255);
let in_ram = fn mem -> fn a ->
  a >= dram_base && a - dram_base + 3 < vec_len mem;
let ld32 = fn mem -> fn a ->
  ldb mem a + ldb mem (a + 1) * 256 + ldb mem (a + 2) * 65536 + ldb mem (a + 3) * 16777216;
let st32 = fn mem -> fn a -> fn v ->
  let _ = stb mem a v in
  let _ = stb mem (a + 1) (bit_shr v 8) in
  let _ = stb mem (a + 2) (bit_shr v 16) in
  stb mem (a + 3) (bit_shr v 24);

// --- the guest's open files: openat / read / close / faccessat --------------
// A hosted `-rv` program can read a file now (mere v0.1.402 lowers read_file
// and file_exists onto these Linux numbers), so this has to answer for them.
//
// The whole file is read at OPEN time into one arena and the fd carries a
// cursor over that snapshot. Mere has no descriptor-level file API to pass
// straight through, and the program this emulator is carried for opens a
// script, reads it to the end and closes it -- for which a cursor over a
// snapshot gives the same answers a real read would.
//
// It is NOT silent about its limits, because a table that quietly reused a slot
// would hand the guest another file's bytes and a truncating read would look
// like a short file. Past `fd_cap` concurrent files it answers -EMFILE, past the
// arena -ENOMEM, an unknown descriptor -EBADF, and a missing path -ENOENT --
// all of them what Linux says, so a guest that handles the errno handles this.
let fd_cap = 8;
// 0-2 are the standard streams. The guest never opens them, and handing one out
// would make a read of a script indistinguishable from a read of stdin.
let fd_first = 3;
let fd_used = new_vec fd_cap 0;
let fd_base = new_vec fd_cap 0;
let fd_len = new_vec fd_cap 0;
let fd_pos = new_vec fd_cap 0;
// A WRITE fd buffers everything and hands it to the host's write_file at
// close, because Mere's file API is whole-file -- there is no descriptor to
// pass through. The buffer is per-fd (a vec of byte-vecs), so two files open
// for writing at once do not interleave; the path rides in fd_wpath so close
// knows where the bytes go. fd_mode: 0 = read (snapshot cursor), 1 = write.
let fd_mode = new_vec fd_cap 0;
let fd_wpath = new_vec fd_cap "";
// per-fd byte buffers, reused across opens: fd_wlen is the live length and the
// vec is capacity -- a reopened slot writes over old bytes instead of popping
// them (Mere's vec grows but does not shrink, and does not need to here).
let fd_wlen = new_vec fd_cap 0;
let fd_wbuf = vec_new ();
let _ = (let rec go = fn i -> if i >= fd_cap then () else let _ = vec_push fd_wbuf (new_vec 0 0) in go (i + 1) in go 0);
// stdin, slurped ONCE on the first read(0) and served as a cursor: the guest's
// read_stdin drains it to EOF, and a second read_stdin correctly sees empty --
// the same answer a real process gets. -1 in the pos cell means "not read yet".
let stdin_pos = new_vec 1 (0 - 1);
let stdin_buf = new_vec 1 "";
// Closing rolls the arena back when the block was the last one allocated, which
// is every close in a one-file-at-a-time reader -- without it a long `require`
// chain exhausts the arena for files it is no longer holding.
let fbuf_cap = 4194304;
let fbuf = new_vec fbuf_cap 0;
let fbuf_top = new_vec 1 0;
let rec fd_free = fn i ->
  if i >= fd_cap then 0 - 1
  else if vec_get fd_used i == 0 then i
  else fd_free (i + 1);
// A path out of guest memory, NUL-terminated. Bounded: an unterminated pointer
// would otherwise walk off the end of RAM and take the EMULATOR down with a
// bounds fault, reporting a bug in this program instead of in the guest.
let path_max = 4096;
let cstr_at = fn mem -> fn p ->
  let sb = strbuf_new () in
  let rec go = fn i ->
    if i >= path_max then () else
      let c = ldb mem (p + i) in
      if c == 0 then () else let _ = strbuf_push sb (chr c) in go (i + 1) in
  let _ = go 0 in
  strbuf_to_str sb;
let sys_openat = fn mem -> fn pathp -> fn flags ->
  let path = cstr_at mem pathp in
  let wr = bit_and flags 1 in                                          // O_WRONLY
  if str_len path >= path_max then 0 - 36                              // -ENAMETOOLONG
  else if bit_and flags 65536 != 0 then sys_opendir path               // O_DIRECTORY
  else if wr == 1 then
    (let slot = fd_free fd_first in
     if slot < 0 then 0 - 24                                           // -EMFILE
     else
       // O_CREAT|O_TRUNC means the file exists and is empty the moment open
       // returns -- so DO that, now, with the host's write_file. It is also the
       // path check: a directory that does not exist fails HERE, as -ENOENT the
       // guest's try_or can catch, instead of at close where the buffered bytes
       // have nowhere to go and an uncaught host fail would take the EMULATOR
       // down -- reporting the guest's bad path as our crash.
       let ok = try_or (fn (u: unit) -> let _ = write_file path "" in true) false in
       if ok then
         (let _ = vec_set fd_used slot 1 in
          let _ = vec_set fd_mode slot 1 in
          let _ = vec_set fd_wpath slot path in
          let _ = vec_set fd_wlen slot 0 in
          slot)
       else 0 - 2)                                                     // -ENOENT
  else if file_exists path then
    let slot = fd_free fd_first in
    if slot < 0 then 0 - 24                                            // -EMFILE
    else
      let bytes = read_file_bytes path in
      let n = vec_len bytes in
      let base = vec_get fbuf_top 0 in
      if base + n > fbuf_cap then 0 - 12                               // -ENOMEM
      else
        let rec copy = fn i ->
          if i >= n then () else
            let _ = vec_set fbuf (base + i) (vec_get bytes i) in copy (i + 1) in
        let _ = copy 0 in
        let _ = vec_set fbuf_top 0 (base + n) in
        let _ = vec_set fd_used slot 1 in
        let _ = vec_set fd_base slot base in
        let _ = vec_set fd_len slot n in
        let _ = vec_set fd_pos slot 0 in
        slot
  else 0 - 2;                                                          // -ENOENT
let fd_bad = fn fd -> fd < fd_first || fd >= fd_cap || vec_get fd_used fd == 0;
// --- the host's descriptors (v0.1.634 of the compiler) ------------------------
// Every open but a directory's is the host's own descriptor, handed to the
// guest as it is: a write is in the file at once (File#sync, then File.read,
// before the close), a pipe is a pipe, a seek is a seek. Bytes cross through
// the C runtime's byte arena, 64 KB at a time. The guest's stdin, stdout and
// stderr keep their own paths. The errno is the host's -- the same numbers
// on macOS and Linux below 35 -- with the four a file call gives and the two
// number differently put into Linux's: EAGAIN, ELOOP, ENAMETOOLONG, ENOTEMPTY.
extern fn fd_open: str -> str -> int -> int;
extern fn fd_read: int -> int -> int -> int;
extern fn fd_write: int -> int -> int -> int;
extern fn fd_close: int -> int;
extern fn fd_seek: int -> int -> int -> int;
extern fn fd_dup: int -> int;
extern fn fd_isatty: int -> int;
extern fn fd_pipe: unit -> int;
extern fn fd_last_errno: unit -> int;
extern fn dup2: int -> int -> int;
extern fn fd_sync: int -> int;
extern fn io_set_nonblocking: int -> int;
extern fn mem_alloc: int -> int;
extern fn mem_set_u8: int -> int -> int -> int;
extern fn mem_get_u8: int -> int -> int;
extern fn proc_sig_noop: int -> int;
extern fn proc_sig_default: int -> int;
// v0.1.636 of the compiler: the rest of the file calls its guests make
extern fn symlink: str -> str -> int;
extern fn link: str -> str -> int;
extern fn rename: str -> str -> int;
extern fn fchdir: int -> int;
extern fn chroot: str -> int;
extern fn file_umask: int -> int;
extern fn file_flock: int -> int -> int;
extern fn file_readlink: str -> int -> int -> int;
extern fn file_utime: str -> int -> int -> int;
let hbuf_cap = 65536;
let hbuf = mem_alloc hbuf_cap;
let lin_errno = fn e ->
  if e == 35 then 11 else if e == 62 then 40 else if e == 63 then 36 else if e == 66 then 39 else e;
let host_r = fn r -> if r < 0 then 0 - lin_errno (fd_last_errno ()) else r;
// which numbers the host handed out: a write goes to the host only on one of
// these. The guest's print never said which descriptor it meant (a0 held the
// string), and this emulator printed every other write -- programs built
// before v0.1.634 still do that, and still print.
let hfd_cap = 4096;
// the status the guest's exit (93) asked for; the emulator ends with it
let guest_status = new_vec 1 0;
let hfd = new_vec hfd_cap 0;
let hfd_is = fn fd -> fd > 2 && fd < hfd_cap && vec_get hfd fd == 1;
let hfd_keep = fn r -> let _ = (if r > 2 && r < hfd_cap then vec_set hfd r 1 else ()) in r;
let hfd_drop = fn fd -> fn r -> let _ = (if r == 0 && fd > 2 && fd < hfd_cap then vec_set hfd fd 0 else ()) in r;
// Linux open flags back into a mode fopen takes; one that writes without
// truncating opens read-write ("r+"), creating the file first for O_CREAT
let host_open = fn path -> fn flags -> fn perm ->
  let acc = bit_and flags 3 in
  let cr = bit_and flags 64 != 0 in
  let ex = bit_and flags 128 != 0 in
  let tr = bit_and flags 512 != 0 in
  let ap = bit_and flags 1024 != 0 in
  if ex && cr && file_exists path then 0 - 17                          // -EEXIST
  else
    let mode = if acc == 0 then "r"
               else if ap then (if acc == 2 then "a+" else "a")
               else if tr && cr then (if acc == 2 then "w+" else "w")
               else "r+" in
    let _ = (if cr && mode == "r+" && (if file_exists path then false else true)
             then (let _ = try_or (fn (u: unit) -> let _ = write_file path "" in true) false in ()) else ()) in
    hfd_keep (host_r (fd_open path mode perm));
let host_read = fn mem -> fn fd -> fn buf -> fn cnt ->
  let n = if cnt < hbuf_cap then cnt else hbuf_cap in
  let r = fd_read fd hbuf n in
  if r < 0 then host_r r
  else
    let rec copy = fn i -> if i >= r then () else let _ = stb mem (buf + i) (mem_get_u8 hbuf i) in copy (i + 1) in
    let _ = copy 0 in
    r;
let rec host_write = fn mem -> fn fd -> fn buf -> fn cnt -> fn done ->
  if done >= cnt then done
  else
    let n = if cnt - done < hbuf_cap then cnt - done else hbuf_cap in
    let rec copy = fn i -> if i >= n then () else let _ = mem_set_u8 hbuf i (ldb mem (buf + done + i)) in copy (i + 1) in
    let _ = copy 0 in
    let r = fd_write fd hbuf n in
    if r < 0 then (if done > 0 then done else host_r r)
    else if r < n then done + r
    else host_write mem fd buf cnt (done + r);
// newfstatat, from the host's stat through the C runtime's file_stat device
// (Mere's extern ABI cannot name a struct stat): the 128 bytes of Linux's
// riscv64 struct stat -- on both widths, a contract of this emulator's, since
// rv32 Linux has only statx -- little-endian, the padding zero.
extern fn getpid: unit -> int;
extern fn access: str -> int -> int;
extern fn file_stat: str -> int;
extern fn file_lstat: str -> int;
extern fn file_stat_field: int -> int;
extern fn chdir: str -> int;
extern fn file_chmod: str -> int -> int;
let sys_fstatat = fn mem -> fn pathp -> fn buf -> fn flags ->
  let p = cstr_at mem pathp in
  let r = if bit_and flags 256 != 0 then file_lstat p else file_stat p in
  if r < 0 then (if file_exists p then 0 - 13 else 0 - 2)
  else
    let rec zero = fn i -> if i >= 128 then () else let _ = stb mem (buf + i) 0 in zero (i + 1) in
    let _ = zero 0 in
    let rec le = fn off -> fn v -> fn n ->
      if n == 0 then () else let _ = stb mem (buf + off) (bit_and v 255) in le (off + 1) (bit_shr v 8) (n - 1) in
    let _ = le 0 (file_stat_field 0) 8 in
    let _ = le 8 (file_stat_field 1) 8 in
    let _ = le 16 (file_stat_field 2) 4 in
    let _ = le 20 (file_stat_field 3) 4 in
    let _ = le 24 (file_stat_field 4) 4 in
    let _ = le 28 (file_stat_field 5) 4 in
    let _ = le 32 (file_stat_field 6) 8 in
    let _ = le 48 (file_stat_field 7) 8 in
    let _ = le 56 (file_stat_field 11) 4 in
    let _ = le 64 (file_stat_field 12) 8 in
    let _ = le 72 (file_stat_field 8) 8 in
    let _ = le 88 (file_stat_field 9) 8 in
    let _ = le 104 (file_stat_field 10) 8 in
    0;
// A DIRECTORY opened with O_DIRECTORY (fd_mode 2) is a snapshot too: its names
// (Mere's dir_entries, with "." and ".." in front as the kernel gives them),
// laid out once as linux_dirent64 records -- u64 ino, s64 off, u16 reclen,
// u8 type, the name and its NUL, padded to 8 -- for getdents64 to hand out
// whole. The ino is the position (no host inode reaches here) and the type
// DT_UNKNOWN, which a reader must be ready for on any filesystem.
let rec split_nul = fn s -> fn i -> fn start -> fn acc ->
  if i >= str_len s then acc
  else if ord (char_at s i) == 0 then split_nul s (i + 1) (i + 1) (Cons (substring s start i, acc))
  else split_nul s (i + 1) start acc;
// v0.1.634 of the compiler: directory snapshots are numbered from here, out
// of the way of the host's own descriptors, which every other open now is
let dir_fd_base = 1000;
let rec rev_onto = fn l -> fn acc -> match l with Nil -> acc | Cons (h, t) -> rev_onto t (Cons (h, acc));
let sys_opendir = fn path ->
  if (if file_exists path then false else true) then 0 - 2               // -ENOENT
  else if (if file_exists (path ++ "/.") then false else true) then 0 - 20 // -ENOTDIR
  else
    let slot = fd_free fd_first in
    if slot < 0 then 0 - 24                                              // -EMFILE
    else
      let names = Cons (".", Cons ("..", rev_onto (split_nul (dir_entries path) 0 0 Nil) Nil)) in
      let base = vec_get fbuf_top 0 in
      let rec lay = fn l -> fn at -> fn k ->
        match l with
        | Nil -> at
        | Cons (nm, rest) ->
          let n = str_len nm in
          let reclen = bit_and (19 + n + 1 + 7) (0 - 8) in
          if at + reclen > fbuf_cap then 0 - 1 else
          let rec zero = fn i -> if i >= reclen then () else let _ = vec_set fbuf (at + i) 0 in zero (i + 1) in
          let _ = zero 0 in
          let rec le = fn off -> fn v -> fn k2 ->
            if k2 == 0 then () else let _ = vec_set fbuf (at + off) (bit_and v 255) in le (off + 1) (bit_shr v 8) (k2 - 1) in
          let _ = le 0 (k + 1) 8 in
          let _ = le 8 (k + 1) 8 in
          let _ = le 16 reclen 2 in
          let rec name = fn i -> if i >= n then () else let _ = vec_set fbuf (at + 19 + i) (ord (char_at nm i)) in name (i + 1) in
          let _ = name 0 in
          lay rest (at + reclen) (k + 1) in
      let top = lay names base 0 in
      if top < 0 then 0 - 12                                             // -ENOMEM
      else
        let _ = vec_set fbuf_top 0 top in
        let _ = vec_set fd_used slot 1 in
        let _ = vec_set fd_mode slot 2 in
        let _ = vec_set fd_base slot base in
        let _ = vec_set fd_len slot (top - base) in
        let _ = vec_set fd_pos slot 0 in
        dir_fd_base + slot;
// getdents64: whole records from the cursor, as many as fit in cnt; 0 at the
// end; -EINVAL when not even the next one fits
let sys_getdents = fn mem -> fn fd0 -> fn buf -> fn cnt ->
  let fd = fd0 - dir_fd_base in
  if fd_bad fd then 0 - 9                                                // -EBADF
  else if vec_get fd_mode fd != 2 then 0 - 20                            // -ENOTDIR
  else
    let base = vec_get fd_base fd in
    let len = vec_get fd_len fd in
    let rec take = fn pos -> fn got ->
      if pos >= len then got
      else
        let reclen = vec_get fbuf (base + pos + 16) + 256 * vec_get fbuf (base + pos + 17) in
        if got + reclen > cnt then got
        else
          let rec copy = fn i -> if i >= reclen then () else let _ = stb mem (buf + got + i) (vec_get fbuf (base + pos + i)) in copy (i + 1) in
          let _ = copy 0 in
          take (pos + reclen) (got + reclen) in
    let pos0 = vec_get fd_pos fd in
    let got = take pos0 0 in
    if got == 0 && pos0 < len then 0 - 22                                // -EINVAL
    else (let _ = vec_set fd_pos fd (pos0 + got) in got);
// read(0): the guest asking for OUR stdin. Slurped once, then a cursor.
let sys_read_stdin = fn mem -> fn buf -> fn cnt ->
  let _ = (if vec_get stdin_pos 0 < 0 then
             let _ = vec_set stdin_buf 0 (read_stdin ()) in
             vec_set stdin_pos 0 0
           else ()) in
  let s = vec_get stdin_buf 0 in
  let pos = vec_get stdin_pos 0 in
  let left = str_len s - pos in
  let n = if cnt < left then cnt else left in
  let rec copy = fn i ->
    if i >= n then () else
      let _ = stb mem (buf + i) (ord (char_at s (pos + i))) in copy (i + 1) in
  let _ = copy 0 in
  let _ = vec_set stdin_pos 0 (pos + n) in
  n;
let sys_read = fn mem -> fn fd -> fn buf -> fn cnt ->
  if fd == 0 then sys_read_stdin mem buf cnt
  else if fd_bad fd then 0 - 9                                         // -EBADF
  else if vec_get fd_mode fd == 1 then 0 - 9                           // -EBADF: write fd
  else if vec_get fd_mode fd == 2 then 0 - 21                          // -EISDIR
  else
    let pos = vec_get fd_pos fd in
    let left = vec_get fd_len fd - pos in
    let n = if cnt < left then cnt else left in
    let base = vec_get fd_base fd in
    let rec copy = fn i ->
      if i >= n then () else
        let _ = stb mem (buf + i) (vec_get fbuf (base + pos + i)) in copy (i + 1) in
    let _ = copy 0 in
    let _ = vec_set fd_pos fd (pos + n) in
    n;
// A guest write to one of our write fds: append to that fd's buffer. The
// bytes land on the HOST at close, all at once, through write_file.
let sys_write_fd = fn mem -> fn fd -> fn buf -> fn cnt ->
  let b = vec_get fd_wbuf fd in
  let pos = vec_get fd_wlen fd in
  let rec go = fn i ->
    if i >= cnt then () else
      let byte = ldb mem (buf + i) in
      let _ = (if pos + i < vec_len b then vec_set b (pos + i) byte
               else vec_push b byte) in
      go (i + 1) in
  let _ = go 0 in
  let _ = vec_set fd_wlen fd (pos + cnt) in
  cnt;
let sys_close = fn fd ->
  if fd_bad fd then 0 - 9                                              // -EBADF
  else if vec_get fd_mode fd == 1 then
    // the write fd's moment: everything buffered becomes the file, atomically
    // from the guest's point of view. write_file replaces, which is the
    // O_TRUNC the open promised.
    let b = vec_get fd_wbuf fd in
    let sb = strbuf_new () in
    let n = vec_get fd_wlen fd in
    let rec go = fn i ->
      if i >= n then () else let _ = strbuf_push sb (chr (vec_get b i)) in go (i + 1) in
    let _ = go 0 in
    // The oracle's own shape: C's write_file checks the OPEN and ignores write
    // and close errors after it (fwrite's count is discarded, fclose unchecked).
    // So a failure here is swallowed to match -- but through try_or, because an
    // uncaught host fail here would kill the emulator, not the guest.
    let _ = try_or (fn (u: unit) -> let _ = write_file (vec_get fd_wpath fd) (strbuf_to_str sb) in true) false in
    let _ = vec_set fd_mode fd 0 in
    let _ = vec_set fd_used fd 0 in
    0
  else
    let base = vec_get fd_base fd in
    let top = base + vec_get fd_len fd in
    let _ = if top == vec_get fbuf_top 0 then vec_set fbuf_top 0 base else () in
    let _ = vec_set fd_mode fd 0 in
    let _ = vec_set fd_used fd 0 in
    0;

// --- the ABI contract instrument (armed by `abi` on the command line) --------
// On every call that WRITES ra, snapshot the callee-saved registers s1..s10
// (x9, x18..x26); on every plain `ret`, find the frame whose return address is
// the ret's target and compare. A mismatch names the pc, the register, and
// both values -- which is a violated calling convention, the thing that is
// otherwise visible only as a value silently wrong much later.
//
// s11 (x27) is excluded: it is the backend's far-jump scratch, dead between
// jumps, and the first run of the ad-hoc version reported it as a false
// positive before the exclusion was understood.
//
// UNWIND-AWARE, which the ad-hoc version never had to be: a `fail` caught by
// try_or is a longjmp, not a return, so frames are popped WITHOUT comparison
// until the return address matches -- those frames never returned, and holding
// their calls to the returned-state contract would accuse every caught failure.
// A ret matching NOTHING on the stack clears it (control went somewhere new).
let abi_on = new_vec 1 0;
let abi_ra = vec_new ();
let abi_s = vec_new ();
let abi_n = new_vec 1 0;
let abi_hits = new_vec 1 0;
let abi_push = fn x -> fn (link: int) ->
  let n = vec_get abi_n 0 in
  let _ = (if n < vec_len abi_ra then vec_set abi_ra n link else vec_push abi_ra link) in
  let rec put = fn (i: int) ->
    if i >= 10 then () else
      let r = if i == 0 then 9 else 17 + i in
      let v = vec_get x r in
      let slot = n * 10 + i in
      let _ = (if slot < vec_len abi_s then vec_set abi_s slot v else vec_push abi_s v) in
      put (i + 1) in
  let _ = put 0 in
  vec_set abi_n 0 (n + 1);
let abi_ret = fn x -> fn (target: int) -> fn (pc: int) ->
  let rec seek = fn (n: int) ->
    if n <= 0 then 0 - 1
    else if vec_get abi_ra (n - 1) == target then n - 1
    else seek (n - 1) in
  let hit = seek (vec_get abi_n 0) in
  if hit < 0 then vec_set abi_n 0 0
  else
    let rec cmp = fn (i: int) ->
      if i >= 10 then () else
        let r = if i == 0 then 9 else 17 + i in
        let want = vec_get abi_s (hit * 10 + i) in
        let got = vec_get x r in
        let _ = (if want == got then () else
          let _ = vec_set abi_hits 0 (vec_get abi_hits 0 + 1) in
          print_err ("ABI: x" ++ str_of_int r ++ " not preserved across the call returning to "
                     ++ str_of_int target ++ " (ret at pc=" ++ str_of_int pc
                     ++ "): saved " ++ str_of_int want ++ ", now " ++ str_of_int got ++ "\n")) in
        cmp (i + 1) in
    let _ = cmp 0 in
    vec_set abi_n 0 hit;

// --- register file (x0 stays 0; writes to x0 are dropped) ----------------
let wrx = fn x -> fn i -> fn v -> if i == 0 then () else vec_set x i (mask32 v);

// unsigned 32x32 -> high 32 bits of the 64-bit product. Schoolbook over 16-bit
// halves so every intermediate stays < 2^32 (safe on the 63-bit interpreter and
// on the i64 native backends alike). gcc lowers `/`/`%` by a constant to a
// MULHU by the reciprocal, so real -O2 output needs this.
let mulhu32 = fn a -> fn b ->
  let al = bit_and a 65535 in let ah = bit_shr (mask32 a) 16 in
  let bl = bit_and b 65535 in let bh = bit_shr (mask32 b) 16 in
  let ll = al * bl in
  let lh = al * bh in
  let hl = ah * bl in
  let hh = ah * bh in
  let mid = bit_shr ll 16 + bit_and lh 65535 + bit_and hl 65535 in
  mask32 (hh + bit_shr lh 16 + bit_shr hl 16 + bit_shr mid 16);

// --- immediate decoders (mirror the asm_* encoders below) ----------------
let imm_i = fn inst -> sign_ext (bit_and (bit_shr inst 20) 4095) 12;
let imm_s = fn inst ->
  sign_ext (bit_or (bit_shl (bit_and (bit_shr inst 25) 127) 5) (bit_and (bit_shr inst 7) 31)) 12;
let imm_b = fn inst ->
  let b12 = bit_and (bit_shr inst 31) 1 in
  let b11 = bit_and (bit_shr inst 7) 1 in
  let b10_5 = bit_and (bit_shr inst 25) 63 in
  let b4_1 = bit_and (bit_shr inst 8) 15 in
  sign_ext (bit_or (bit_shl b12 12) (bit_or (bit_shl b11 11) (bit_or (bit_shl b10_5 5) (bit_shl b4_1 1)))) 13;
let imm_u = fn inst -> bit_and inst 4294963200;            // 0xFFFFF000
let imm_j = fn inst ->
  let b20 = bit_and (bit_shr inst 31) 1 in
  let b19_12 = bit_and (bit_shr inst 12) 255 in
  let b11 = bit_and (bit_shr inst 20) 1 in
  let b10_1 = bit_and (bit_shr inst 21) 1023 in
  sign_ext (bit_or (bit_shl b20 20) (bit_or (bit_shl b19_12 12) (bit_or (bit_shl b11 11) (bit_shl b10_1 1)))) 21;

// --- decode + execute one instruction ------------------------------------
// st: [PC, HALT, WHY]
// --- device MMIO ----------------------------------------------------------
// Devices live above any RAM, so a device address does not move when the RAM
// size does and a guest can name one as a literal. The UART data register is
// at QEMU virt's 0x10000000: a byte store goes to stdout as it happens, which is
// what a shell needs. The write(2) syscall does the same now -- it used to fill a
// vec that was emptied after the guest halted, so a run that was killed showed
// nothing.
let mmio_base = 268435456;   // 0x10000000
let mmio_len = 65536;
// A minimal CLINT: a monotonic counter and a comparand. Both 32-bit here, where
// the real thing is 64-bit — a 32-bit mtime is enough for a scheduler tick and
// keeps every access a single word.
//
// In virt mode the two registers move to the addresses QEMU's board uses, which
// are 32 KB apart rather than adjacent. That is the whole difference a guest
// sees between the two machines, aside from where RAM is.
let clint_mtime = if virt == 1 then 33603576 else 268468224;      // 0x0200bff8 / 0x10008000
let clint_mtimecmp = if virt == 1 then 33570816 else 268468232;   // 0x02004000 / 0x10008008
// virt's test finisher: 0x5555 powers the machine off. A guest that wants to
// stop has no host syscall on that board, so stopping is a device.
let test_finisher = 1048576;      // 0x00100000
let timer = new_vec 2 0;          // [mtime, mtimecmp]
// Which addresses are devices, named rather than "anything above RAM": on virt
// the devices are *below* RAM, so there is no single threshold left to compare
// against, and an address that is neither RAM nor a device should fault rather
// than read as zero.
let is_device = fn a ->
  a >= mmio_base && a < mmio_base + mmio_len
  || a >= clint_mtimecmp && a < clint_mtimecmp + 8
  || a >= clint_mtime && a < clint_mtime + 8
  || a >= test_finisher && a < test_finisher + 8;
let mmio_store = fn st -> fn addr -> fn v ->
  if addr == mmio_base then print_no_nl (chr (bit_and v 255))
  else if addr == clint_mtimecmp then vec_set timer 1 (mask32 v)
  else if addr == clint_mtime then vec_set timer 0 (mask32 v)
  else if addr == test_finisher then halt st halt_finisher
  else ();

// Receive side: one byte of lookahead, because the guest asks "is anything
// waiting?" before it asks "what is it?". `stdin_byte` polls without blocking
// (read_key would stop the machine dead until a key arrived, which is no use
// to a CPU that also has timers to service).
let rx = new_vec 1 (0 - 1);
let rx_poll = fn () ->
  if vec_get rx 0 < 0 then vec_set rx 0 (stdin_byte ()) else ();
// 16550 line status: bit 5 = transmitter empty (always), bit 0 = data ready.
let mmio_load = fn addr ->
  if addr == clint_mtime then vec_get timer 0
  else if addr == clint_mtimecmp then vec_get timer 1
  else if addr == mmio_base + 5 then
    let _ = rx_poll () in
    if vec_get rx 0 >= 0 then 97 else 96
  else if addr == mmio_base then
    let _ = rx_poll () in
    let b = vec_get rx 0 in
    if b < 0 then 0 else let _ = vec_set rx 0 (0 - 1) in b
  else 0;

// --- machine CSRs ---------------------------------------------------------
// 4096 slots, one per CSR number, so csrrw/csrrs/csrrc need no lookup table.
// Only machine mode exists here: mtvec / mepc / mcause / mstatus / mie / mip /
// mscratch are just numbers until traps arrive, and `mret` reads mepc.
let csr = new_vec 4096 0;
let csr_mstatus = 768;   // 0x300
let csr_mtvec = 773;     // 0x305
let csr_mepc = 833;      // 0x341
let csr_mcause = 834;    // 0x342
let csr_mtval = 835;     // 0x343

// Take a trap: park the faulting PC in mepc, the reason in mcause, the offending
// value in mtval, move MIE into MPIE (so mret can put it back), and vector to
// mtvec. Direct mode only — the low two bits of mtvec select vectored mode,
// which nothing here needs, so they are masked off.
// A guest with mtvec still zero has nowhere to go: that halts, as it did before
// traps existed, rather than jumping to address 0 and corrupting itself.
let take_trap = fn st -> fn cause -> fn tval -> fn pc ->
  let tvec = vec_get csr csr_mtvec in
  if tvec == 0 then halt st halt_trap
  else
    let ms = vec_get csr csr_mstatus in
    let mie = bit_and (bit_shr ms 3) 1 in
    let _ = vec_set csr csr_mstatus
              (bit_or (bit_and ms 4294967175) (bit_shl mie 7)) in  // MIE=0, MPIE=MIE
    let _ = vec_set csr csr_mepc (mask32 pc) in
    let _ = vec_set csr csr_mcause (mask32 cause) in
    let _ = vec_set csr csr_mtval (mask32 tval) in
    vec_set st 0 (bit_and tvec 4294967292);
// --- RVV 1.0 subset (Q-110): VLEN = 128, LMUL = 1, SEW = e8, plus e16 only to read a
// widening reduction. Enough for `mere -rv` to run the u8x16 operations the UTF-8
// validator needs; everything else in OP-V traps as illegal, so a program that
// leans on a wider subset says so instead of computing something quiet. ------------
let vregs = new_vec 512 0;             // 32 registers x 16 bytes, one element per byte
let vstate = new_vec 2 0;              // 0: vl, 1: vtype (the zimm as written)
let vget = fn r -> fn i -> vec_get vregs (r * 16 + i);
let vset = fn r -> fn i -> fn v -> vec_set vregs (r * 16 + i) (bit_and v 255);
let vsew = fn () -> bit_and (bit_shr (vec_get vstate 1) 3) 7;              // 0 = e8, 1 = e16
let mask_bit = fn r -> fn i -> bit_and (bit_shr (vget r (i / 8)) (i % 8)) 1;
let set_mask_bit = fn r -> fn i -> fn b ->
  let byte = vget r (i / 8) in
  let m = bit_shl 1 (i % 8) in
  vset r (i / 8) (if b == 1 then bit_or byte m else bit_and byte (255 - m));
let sext5 = fn v -> if v >= 16 then v - 32 else v;
// vsetvli / vsetivli: only m1 with e8 or e16 is a legal vtype here; vl = min(avl, VLMAX)
let vsetvl = fn x -> fn st -> fn rd -> fn rs1 -> fn avl_imm -> fn vtype -> fn inst -> fn pc ->
  let lmul = bit_and vtype 7 in
  let sew = bit_and (bit_shr vtype 3) 7 in
  if lmul != 0 || sew > 1 then take_trap st 2 inst pc
  else
    let vlmax = if sew == 1 then 8 else 16 in
    let avl = if avl_imm >= 0 then avl_imm
              else if rs1 != 0 then vec_get x rs1
              else if rd != 0 then vlmax
              else vec_get vstate 0 in
    let vl = if avl > vlmax then vlmax else avl in
    let _ = vec_set vstate 0 vl in
    let _ = vec_set vstate 1 vtype in
    wrx x rd vl;
let vexec = fn mem -> fn x -> fn st -> fn inst -> fn pc -> fn op -> fn f3 -> fn rd -> fn rs1 -> fn rs2 -> fn a ->
  let vl = vec_get vstate 0 in
  let f6 = bit_and (bit_shr inst 26) 63 in
  let vm = bit_and (bit_shr inst 25) 1 in
  if op == 0x07 || op == 0x27 then                                   // vle8.v / vse8.v vd, (rs1)
    if f6 != 0 || vm != 1 || rs2 != 0 then take_trap st 2 inst pc
    else if in_ram mem a == false || in_ram mem (a + 15) == false then
      take_trap st (if op == 0x07 then 5 else 7) a pc
    else
      let rec go = fn i ->
        if i >= vl then ()
        else
          let _ = (if op == 0x07 then vset rd i (ldb mem (a + i)) else stb mem (a + i) (vget rd i)) in
          go (i + 1) in
      go 0
  else if f3 == 7 then                                               // vsetvli / vsetivli
    if bit_and (bit_shr inst 31) 1 == 0 then
      vsetvl x st rd rs1 (0 - 1) (bit_and (bit_shr inst 20) 2047) inst pc
    else if bit_and (bit_shr inst 30) 1 == 1 then
      vsetvl x st rd 0 rs1 (bit_and (bit_shr inst 20) 1023) inst pc
    else take_trap st 2 inst pc                                      // vsetvl rs2-form: not here
  else if f3 == 0 || f3 == 3 || f3 == 4 then                         // OPIVV / OPIVI / OPIVX
    let op2 = fn i -> if f3 == 0 then vget rs1 i
                      else if f3 == 4 then bit_and a 255
                      else bit_and (sext5 rs1) 255 in
    let amount = if f3 == 4 then a else if f3 == 3 then rs1 else 0 in   // slides: the raw count
    let rec each = fn i -> fn f ->
      if i >= vl then () else let _ = vset rd i (f (vget rs2 i) (op2 i)) in each (i + 1) f in
    if f6 == 0 then each 0 (fn s -> fn t -> s + t)                              // vadd
    else if f6 == 2 then each 0 (fn s -> fn t -> s - t)                         // vsub
    else if f6 == 9 then each 0 (fn s -> fn t -> bit_and s t)                   // vand
    else if f6 == 10 then each 0 (fn s -> fn t -> bit_or s t)                   // vor
    else if f6 == 11 then each 0 (fn s -> fn t -> bit_xor s t)                  // vxor
    else if f6 == 34 then each 0 (fn s -> fn t -> if s > t then s - t else 0)   // vssubu
    else if f6 == 40 then each 0 (fn s -> fn t -> bit_shr s (bit_and t 7))      // vsrl
    else if f6 == 24 then                                                        // vmseq -> mask in vd
      let rec m = fn i ->
        if i >= vl then () else
          let _ = set_mask_bit rd i (if vget rs2 i == op2 i then 1 else 0) in m (i + 1) in
      m 0
    else if f6 == 23 then                                                        // vmerge (v0 mask) / vmv.v
      let rec m = fn i ->
        if i >= vl then () else
          let _ = vset rd i (if vm == 1 || mask_bit 0 i == 1 then op2 i else vget rs2 i) in m (i + 1) in
      m 0
    else if f6 == 12 && f3 == 0 then                                             // vrgather.vv: index >= VLMAX gives 0
      // vd overlapping vs1 or vs2 is a reserved encoding: QEMU raises illegal, so do we
      if rd == rs1 || rd == rs2 then take_trap st 2 inst pc else
      let rec m = fn i ->
        if i >= vl then () else
          let j = vget rs1 i in
          let _ = vset rd i (if j < 16 then vget rs2 j else 0) in m (i + 1) in
      m 0
    else if f6 == 14 && f3 != 0 then                                             // vslideup.vx / .vi: vd[i] = vs2[i-k], i >= k
      if rd == rs2 then take_trap st 2 inst pc else                                // reserved overlap, as on QEMU
      let rec m = fn i ->
        if i < amount then m (i + 1)
        else if i >= vl then () else let _ = vset rd i (vget rs2 (i - amount)) in m (i + 1) in
      m 0
    else if f6 == 15 && f3 != 0 then                                             // vslidedown.vx / .vi: vd[i] = vs2[i+k] or 0
      let rec m = fn i ->
        if i >= vl then () else
          let _ = vset rd i (if i + amount < 16 then vget rs2 (i + amount) else 0) in m (i + 1) in
      m 0
    else if f6 == 48 && f3 == 0 then                                             // vwredsumu.vs: e16 sum into vd[0]
      let rec sum = fn i -> fn acc -> if i >= vl then acc else sum (i + 1) (acc + vget rs2 i) in
      let s = sum 0 (vget rs1 0 + vget rs1 1 * 256) in
      let _ = vset rd 0 (bit_and s 255) in
      vset rd 1 (bit_and (bit_shr s 8) 255)
    else take_trap st 2 inst pc
  else if f3 == 2 then                                               // OPMVV
    if f6 == 0 then                                                  // vredsum.vs (e8, wraps)
      let rec sum = fn i -> fn acc -> if i >= vl then acc else sum (i + 1) (acc + vget rs2 i) in
      vset rd 0 (sum 0 (vget rs1 0))
    else if f6 == 2 then                                             // vredor.vs
      let rec o = fn i -> fn acc -> if i >= vl then acc else o (i + 1) (bit_or acc (vget rs2 i)) in
      vset rd 0 (o 0 (vget rs1 0))
    else if f6 == 16 && rs1 == 0 then                                // vmv.x.s rd, vs2 (element 0, SEW wide)
      wrx x rd (if vsew () == 1 then vget rs2 0 + vget rs2 1 * 256 else vget rs2 0)
    else take_trap st 2 inst pc
  else take_trap st 2 inst pc;

let step = fn mem -> fn x -> fn st ->
  let pc = vec_get st 0 in
  // The fetch needs the same guard the loads and stores have: a guest that jumps
  // somewhere it does not have used to take the emulator down with an "index out
  // of bounds" about the host's array. An instruction access fault (cause 1) is
  // the guest's own problem, reported in the guest's terms.
  if in_ram mem pc == false then take_trap st 1 pc pc else
  let inst = ld32 mem pc in
  let _ = vec_set st 0 (mask32 (pc + 4)) in                // sequential next PC (branches override)
  let op = bit_and inst 127 in
  let rd = bit_and (bit_shr inst 7) 31 in
  let f3 = bit_and (bit_shr inst 12) 7 in
  let rs1 = bit_and (bit_shr inst 15) 31 in
  let rs2 = bit_and (bit_shr inst 20) 31 in
  let f7 = bit_and (bit_shr inst 25) 127 in
  let a = vec_get x rs1 in
  let b = vec_get x rs2 in
  if op == 0x37 then wrx x rd (imm_u inst)                              // LUI
  else if op == 0x17 then wrx x rd (mask32 (pc + imm_u inst))           // AUIPC
  else if op == 0x6F then                                              // JAL
    let _ = (if vec_get abi_on 0 == 1 && rd == 1 then abi_push x (mask32 (pc + 4)) else ()) in
    let _ = wrx x rd (mask32 (pc + 4)) in
    vec_set st 0 (mask32 (pc + imm_j inst))
  else if op == 0x67 then                                             // JALR
    let t = bit_and (mask32 (a + imm_i inst)) 4294967294 in            // clear bit 0
    let _ = (if vec_get abi_on 0 == 1 then
               (if rd == 1 then abi_push x (mask32 (pc + 4))
                else if rd == 0 && rs1 == 1 then abi_ret x t pc
                else ())
             else ()) in
    let _ = wrx x rd (mask32 (pc + 4)) in
    vec_set st 0 t
  else if op == 0x63 then                                             // branches
    let take =
      if f3 == 0 then (if a == b then 1 else 0)                        // BEQ
      else if f3 == 1 then (if a == b then 0 else 1)                   // BNE
      else if f3 == 4 then (if signed32 a < signed32 b then 1 else 0)  // BLT
      else if f3 == 5 then (if signed32 a >= signed32 b then 1 else 0) // BGE
      else if f3 == 6 then (if mask32 a < mask32 b then 1 else 0)      // BLTU
      else (if mask32 a >= mask32 b then 1 else 0) in                  // BGEU
    if take == 1 then vec_set st 0 (mask32 (pc + imm_b inst)) else ()
  else if op == 0x03 then                                             // loads
    let addr = mask32 (a + imm_i inst) in
    // RAM first, then devices. Asking "is this a device?" first is only right
    // while the devices are above RAM: on virt every RAM address is above the
    // UART, so that test called the whole of memory a device.
    if in_ram mem addr then
      if f3 == 2 then wrx x rd (ld32 mem addr)                        // LW
      else if f3 == 0 then wrx x rd (sign_ext (ldb mem addr) 8)       // LB
      else if f3 == 4 then wrx x rd (ldb mem addr)                    // LBU
      else if f3 == 1 then wrx x rd (sign_ext (ldb mem addr + ldb mem (mask32 (addr + 1)) * 256) 16)  // LH
      else if f3 == 5 then wrx x rd (ldb mem addr + ldb mem (mask32 (addr + 1)) * 256)  // LHU
      else ()
    else if is_device addr then wrx x rd (mmio_load addr)
    // Neither RAM nor a device: the guest's mistake, so it becomes the guest's
    // trap (load access fault). This used to take the emulator down with a Mere
    // "index out of bounds", which reported the host's problem, not the guest's.
    else take_trap st 5 addr pc
  else if op == 0x23 then                                             // stores
    let addr = mask32 (a + imm_s inst) in
    if in_ram mem addr then
      if f3 == 2 then
        let _ = (let w = vec_get watch_addr 0 in
                 if w != 0 && addr >= w && addr < w + 32 then
                   print_err ("rvrun: WATCH store pc=" ++ str_of_int pc ++ " addr=" ++ str_of_int addr ++ " val=" ++ str_of_int b ++ "\n")
                 else ()) in
        let _ = (if vec_get swon 0 == 1 && addr < sw_hi && b > stack_lo && b < 67108864 then
                   let i3 = bit_and (vec_get swi 0) 7 * 3 in
                   let _ = vec_set swring i3 pc in
                   let _ = vec_set swring (i3 + 1) addr in
                   let _ = vec_set swring (i3 + 2) b in
                   vec_set swi 0 (vec_get swi 0 + 1)
                 else ()) in
        st32 mem addr b                                                // SW
      else if f3 == 0 then stb mem addr b                              // SB
      else if f3 == 1 then                                             // SH
        let _ = stb mem addr b in stb mem (mask32 (addr + 1)) (bit_shr b 8)
      else ()
    else if is_device addr then mmio_store st addr b
    else take_trap st 7 addr pc                                       // store access fault
  else if op == 0x13 then                                             // I-type ALU
    let imm = imm_i inst in
    if f3 == 0 then wrx x rd (mask32 (a + imm))                       // ADDI
    else if f3 == 2 then wrx x rd (if signed32 a < imm then 1 else 0) // SLTI
    else if f3 == 3 then wrx x rd (if mask32 a < mask32 imm then 1 else 0)  // SLTIU
    else if f3 == 4 then wrx x rd (bit_xor a imm)                     // XORI
    else if f3 == 6 then wrx x rd (bit_or a imm)                      // ORI
    else if f3 == 7 then wrx x rd (bit_and a imm)                     // ANDI
    else if f3 == 1 then wrx x rd (mask32 (bit_shl a (bit_and rs2 31)))     // SLLI
    else if f7 == 0 then wrx x rd (bit_shr (mask32 a) (bit_and rs2 31))     // SRLI
    else wrx x rd (sra32 a (bit_and rs2 31))                          // SRAI
  else if op == 0x33 && f7 == 1 then                                  // RV32M (mul/div/rem)
    (if f3 == 0 then wrx x rd (mask32 (a * b))                        // MUL (low 32)
     else if f3 == 3 then wrx x rd (mulhu32 a b)                      // MULHU
     else if f3 == 1 then                                            // MULH (signed x signed)
       let uu = mulhu32 a b in
       let an = bit_shr (mask32 a) 31 in let bn = bit_shr (mask32 b) 31 in
       wrx x rd (mask32 (uu - (if an == 1 then mask32 b else 0) - (if bn == 1 then mask32 a else 0)))
     else if f3 == 2 then                                            // MULHSU (signed x unsigned)
       let uu = mulhu32 a b in
       let an = bit_shr (mask32 a) 31 in
       wrx x rd (mask32 (uu - (if an == 1 then mask32 b else 0)))
     else if f3 == 4 then                                            // DIV (signed)
       let sa = signed32 a in let sb = signed32 b in
       if sb == 0 then wrx x rd 4294967295
       else if sa == (0 - 2147483648) && sb == (0 - 1) then wrx x rd 2147483648
       else wrx x rd (mask32 (sa / sb))
     else if f3 == 5 then                                            // DIVU (unsigned)
       let bu = mask32 b in
       if bu == 0 then wrx x rd 4294967295 else wrx x rd (mask32 (mask32 a / bu))
     else if f3 == 6 then                                            // REM (signed)
       let sa = signed32 a in let sb = signed32 b in
       if sb == 0 then wrx x rd (mask32 sa)
       else if sa == (0 - 2147483648) && sb == (0 - 1) then wrx x rd 0
       else wrx x rd (mask32 (sa - (sa / sb) * sb))
     else if f3 == 7 then                                            // REMU (unsigned)
       let au = mask32 a in let bu = mask32 b in
       if bu == 0 then wrx x rd au else wrx x rd (mask32 (au - (au / bu) * bu))
     else halt st halt_mulh)                                         // MULH/MULHSU/MULHU: not implemented
  else if op == 0x33 then                                             // R-type ALU (base)
    let sh = bit_and b 31 in
    if f3 == 0 then (if f7 == 0 then wrx x rd (mask32 (a + b)) else wrx x rd (mask32 (a - b)))  // ADD/SUB
    else if f3 == 1 then wrx x rd (mask32 (bit_shl a sh))             // SLL
    else if f3 == 2 then wrx x rd (if signed32 a < signed32 b then 1 else 0)  // SLT
    else if f3 == 3 then wrx x rd (if mask32 a < mask32 b then 1 else 0)      // SLTU
    else if f3 == 4 then wrx x rd (bit_xor a b)                       // XOR
    else if f3 == 5 then (if f7 == 0 then wrx x rd (bit_shr (mask32 a) sh) else wrx x rd (sra32 a sh))  // SRL/SRA
    else if f3 == 6 then wrx x rd (bit_or a b)                        // OR
    else wrx x rd (bit_and a b)                                       // AND
  else if op == 0x73 then                                            // SYSTEM
    let csr_n = bit_and (bit_shr inst 20) 4095 in
    if f3 == 1 || f3 == 2 || f3 == 3 then                            // CSRRW / CSRRS / CSRRC
      let old = vec_get csr csr_n in
      let _ = wrx x rd old in
      let v = if f3 == 1 then mask32 a
              else if f3 == 2 then bit_or old a
              else bit_and old (bit_and (bit_not a) 4294967295) in
      vec_set csr csr_n (mask32 v)
    else if f3 == 5 || f3 == 6 || f3 == 7 then                       // the -I forms (rs1 = imm)
      let old = vec_get csr csr_n in
      let _ = wrx x rd old in
      let v = if f3 == 5 then rs1
              else if f3 == 6 then bit_or old rs1
              else bit_and old (bit_and (bit_not rs1) 4294967295) in
      vec_set csr csr_n (mask32 v)
    else if csr_n == 770 then                                        // MRET (0x302)
      // return to mepc, and restore the interrupt-enable bit MPIE -> MIE
      let ms = vec_get csr csr_mstatus in
      let mpie = bit_and (bit_shr ms 7) 1 in
      let ms2 = bit_or (bit_and ms 4294967287) (bit_shl mpie 3) in   // clear MIE, set from MPIE
      let _ = vec_set csr csr_mstatus (bit_or ms2 128) in            // MPIE = 1
      vec_set st 0 (mask32 (vec_get csr csr_mepc))
    else if csr_n == 261 then ()                                     // WFI (0x105) -> nop
    else if vec_get csr csr_mtvec != 0 then
      // A kernel is installed, so an environment call is the guest's business:
      // cause 11, vectored like any other trap. That is what makes a syscall
      // boundary possible — the user process asks, the kernel answers, and the
      // emulator is not in the conversation. With no kernel (mtvec still zero)
      // the tiny host ABI below stands in, which is what every non-bare program
      // on this emulator has always used.
      take_trap st 11 0 pc
    else                                                             // ECALL / EBREAK
      let a7 = vec_get x 17 in                                       // syscall number
      if a7 == 93 then
        // v0.1.637 of the compiler: the guest's status is this process's
        let _ = vec_set guest_status 0 (bit_and (vec_get x 10) 255) in
        halt st halt_exit                             // exit -> halt
      else if a7 == 64 && vec_get x 10 == 2 then                       // write: stderr is the host's
        vec_set x 10 (host_write mem 2 (vec_get x 11) (vec_get x 12) 0)
      else if a7 == 64 && hfd_is (vec_get x 10) then                   // write: the host's fd
        vec_set x 10 (host_write mem (vec_get x 10) (vec_get x 11) (vec_get x 12) 0)
      else if a7 == 64 then                                          // write(fd, buf, len)
        // Printed HERE, not accumulated for the end. The bytes used to go into a
        // vec that was emptied after the guest halted, so a run that was killed
        // -- a 4 MB guest that had not finished after ten minutes -- showed
        // nothing at all, and there was no way to tell a guest making progress
        // from one stuck in a loop. Same shape as the halt that said nothing.
        let buf = vec_get x 11 in
        let len = vec_get x 12 in
        let sb = strbuf_new () in
        let rec emit = fn i ->
          if i >= len then () else
            let _ = strbuf_push sb (chr (ldb mem (mask32 (buf + i)))) in emit (i + 1) in
        let _ = emit 0 in
        let _ = print_no_nl (strbuf_to_str sb) in
        vec_set x 10 len                                             // return bytes written in a0
      // clock_gettime64(clockid, *timespec64) -- Linux's rv32 number, like the
      // write and exit above. Every clockid gets the host's wall clock: this
      // Mere has no separate monotonic source, and a wall clock that a guest
      // uses for elapsed time is wrong only when the host clock steps -- said
      // here rather than papered over. The struct is two little-endian int64s,
      // sec then nsec, written as four words. The host clock is a double of
      // epoch seconds, whose 52-bit mantissa reads out to ~250 ns -- honest for
      // a clock the guest converts straight back to a double.
      else if a7 == 403 then
        let ts = vec_get x 11 in
        let t = time () in
        let sec = int_of_float t in
        let nsec = int_of_float ((t - float_of_int sec) * 1000000000.0) in
        let _ = st32 mem (mask32 ts) (bit_and sec 4294967295) in
        let _ = st32 mem (mask32 (ts + 4)) (bit_shr sec 32) in
        let _ = st32 mem (mask32 (ts + 8)) nsec in
        let _ = st32 mem (mask32 (ts + 12)) 0 in
        vec_set x 10 0
      // getrandom(buf, len, flags) -- host entropy, byte by byte. A machine
      // with no host has none of this, which is why the compiler refuses these
      // under --bare rather than inventing a seed.
      else if a7 == 56 then                                            // openat
        let p = cstr_at mem (vec_get x 11) in
        let fl = vec_get x 12 in
        vec_set x 10 (if str_len p >= path_max then 0 - 36
                      else if bit_and fl 65536 != 0 then sys_opendir p
                      else host_open p fl (vec_get x 13))
      else if a7 == 63 then                                            // read
        let fd = vec_get x 10 in
        vec_set x 10 (if fd == 0 then sys_read_stdin mem (vec_get x 11) (vec_get x 12)
                      else if fd >= dir_fd_base then 0 - 21                // -EISDIR
                      else host_read mem fd (vec_get x 11) (vec_get x 12))
      else if a7 == 57 then                                            // close
        let fd = vec_get x 10 in
        vec_set x 10 (if fd >= dir_fd_base then sys_close (fd - dir_fd_base)
                      else if fd <= 2 then 0
                      else hfd_drop fd (host_r (fd_close fd)))
      // v0.1.636: the host's own answer; libc's leave no errno this side can
      // read, so a failure names the likeliest one from what is on disk
      else if a7 == 36 then                                            // symlinkat
        let t = cstr_at mem (vec_get x 10) in
        let l = cstr_at mem (vec_get x 12) in
        vec_set x 10 (if symlink t l == 0 then 0 else if file_lstat l == 0 then 0 - 17 else 0 - 2)
      else if a7 == 37 then                                            // linkat
        let a = cstr_at mem (vec_get x 11) in
        let b = cstr_at mem (vec_get x 13) in
        vec_set x 10 (if link a b == 0 then 0 else if file_lstat b == 0 then 0 - 17 else 0 - 2)
      else if a7 == 276 then                                           // renameat2
        let a = cstr_at mem (vec_get x 11) in
        let b = cstr_at mem (vec_get x 13) in
        vec_set x 10 (if rename a b == 0 then 0 else if file_lstat a == 0 then 0 - 1 else 0 - 2)
      else if a7 == 50 then                                            // fchdir
        vec_set x 10 (if fchdir (vec_get x 10) == 0 then 0 else 0 - 9)
      else if a7 == 51 then                                            // chroot
        let p = cstr_at mem (vec_get x 10) in
        vec_set x 10 (if chroot p == 0 then 0 else if file_exists p then 0 - 1 else 0 - 2)
      else if a7 == 166 then vec_set x 10 (file_umask (vec_get x 10)) // umask
      else if a7 == 32 then                                            // flock
        let r = file_flock (vec_get x 10) (vec_get x 11) in
        vec_set x 10 (if r == 0 then 0 else if r == 1 then 0 - 11 else 0 - 9)
      else if a7 == 78 then                                            // readlinkat
        let p = cstr_at mem (vec_get x 11) in
        let cap0 = vec_get x 13 in
        let cap = if cap0 < hbuf_cap then cap0 else hbuf_cap in
        let r = file_readlink p hbuf cap in
        if r < 0 then vec_set x 10 (if file_lstat p == 0 then 0 - 22 else 0 - 2)
        else
          let at = vec_get x 12 in
          let rec copy = fn i -> if i >= r then () else let _ = stb mem (at + i) (mem_get_u8 hbuf i) in copy (i + 1) in
          let _ = copy 0 in
          vec_set x 10 r
      else if a7 == 88 then                                            // utimensat
        // two {sec, nsec} pairs of this machine's words; whole seconds
        let p = cstr_at mem (vec_get x 11) in
        let tb = vec_get x 12 in
        vec_set x 10 (if file_utime p (ld32 mem tb) (ld32 mem (tb + 2 * 4)) == 0 then 0
                      else if file_exists p then 0 - 1 else 0 - 2)
      else if a7 == 134 then                                           // rt_sigaction
        // the guest's handler word is SIG_DFL or SIG_IGN; ignoring becomes the
        // host's catch-and-do-nothing (proc_sig_noop), so the emulator's own
        // write to a closed pipe is EPIPE for the guest to see
        let act = vec_get x 11 in
        let h = if act == 0 then 2 else ldb mem act in
        let r = if h == 0 then proc_sig_default (vec_get x 10)
                else if h == 1 then proc_sig_noop (vec_get x 10) else 0 in
        vec_set x 10 (if r < 0 then 0 - 22 else 0)
      else if a7 == 62 then                                            // lseek
        // a 32-bit offset, signed: this machine's registers hold it unsigned
        vec_set x 10 (host_r (fd_seek (vec_get x 10) (signed32 (vec_get x 11)) (vec_get x 12)))
      else if a7 == 82 then vec_set x 10 (host_r (fd_sync (vec_get x 10)))   // fsync
      else if a7 == 23 then vec_set x 10 (hfd_keep (host_r (fd_dup (vec_get x 10))))  // dup
      else if a7 == 24 then vec_set x 10 (hfd_keep (host_r (dup2 (vec_get x 10) (vec_get x 11))))  // dup3
      else if a7 == 59 then                                            // pipe2
        let r = fd_pipe () in
        if r < 0 then vec_set x 10 (host_r r)
        else
          let _ = hfd_keep (bit_shr r 32) in
          let _ = hfd_keep (bit_and r 4294967295) in
          let at = vec_get x 10 in
          let rec put = fn i -> fn v -> if i >= 4 then () else let _ = stb mem (at + i) (bit_and v 255) in put (i + 1) (bit_shr v 8) in
          let _ = put 0 (bit_shr r 32) in
          let _ = (let rec put2 = fn i -> fn v -> if i >= 4 then () else let _ = stb mem (at + 4 + i) (bit_and v 255) in put2 (i + 1) (bit_shr v 8) in put2 0 (bit_and r 4294967295)) in
          vec_set x 10 0
      else if a7 == 29 then                                            // ioctl: TCGETS is isatty
        vec_set x 10 (if vec_get x 11 != 21505 then 0 - 25
                      else if fd_isatty (vec_get x 10) == 1 then 0 else 0 - 25)
      else if a7 == 25 then                                            // fcntl
        // F_GETFL answers read-write; F_SETFL with O_NONBLOCK is the host's
        let cmd = vec_get x 11 in
        vec_set x 10 (if cmd == 3 then 2
                      else if cmd == 4 && bit_and (vec_get x 12) 2048 != 0 then host_r (io_set_nonblocking (vec_get x 10))
                      else 0)
      else if a7 == 48 then                                            // faccessat
        // the mode is the host's access(2)'s to answer (R 4 / W 2 / X 1); a
        // path that is there and refused is -EACCES
        let p = cstr_at mem (vec_get x 11) in
        let m = vec_get x 12 in
        vec_set x 10 (if (if file_exists p then false else true) then 0 - 2
                      else if m == 0 then 0
                      else if access p m == 0 then 0 else 0 - 13)
      else if a7 == 172 then vec_set x 10 (getpid ())             // getpid
      else if a7 == 17 then                                            // getcwd
        // the host's own (Mere v0.1.633's proc_cwd), the length with its
        // NUL as Linux answers, -ERANGE when the buffer is short
        let c = proc_cwd () in
        let buf = vec_get x 10 in
        let n = str_len c in
        if n + 1 > vec_get x 11 then vec_set x 10 (0 - 34)
        else
          let rec put = fn i -> if i >= n then () else let _ = stb mem (buf + i) (ord (char_at c i)) in put (i + 1) in
          let _ = put 0 in
          let _ = stb mem (buf + n) 0 in
          vec_set x 10 (n + 1)
      else if a7 == 49 then                                            // chdir
        // the emulator's own directory moves: every path the guest names
        // after this is resolved from there, as the kernel would
        let p = cstr_at mem (vec_get x 10) in
        vec_set x 10 (if chdir p == 0 then 0 else if file_exists p then 0 - 20 else 0 - 2)
      else if a7 == 53 then                                            // fchmodat
        let p = cstr_at mem (vec_get x 11) in
        vec_set x 10 (if file_chmod p (vec_get x 12) == 0 then 0 else if file_exists p then 0 - 1 else 0 - 2)
      else if a7 == 79 then                                            // newfstatat
        vec_set x 10 (sys_fstatat mem (vec_get x 11) (vec_get x 12) (vec_get x 13))
      else if a7 == 61 then                                            // getdents64
        vec_set x 10 (sys_getdents mem (vec_get x 10) (vec_get x 11) (vec_get x 12))
      else if a7 == 34 then                                            // mkdirat
        // Mere's dir_create; the host's errno is not carried here, so a
        // refusal is told apart only as "something is there" or not
        let p = cstr_at mem (vec_get x 11) in
        vec_set x 10 (if dir_create p (vec_get x 12) == 0 then 0
                      else if file_exists p then 0 - 17 else 0 - 2)
      else if a7 == 35 then                                            // unlinkat
        // flags 0 only: a file, never a directory (AT_REMOVEDIR is refused
        // as unlink refuses one). The host's reason is not carried back --
        // Mere's file_delete answers yes or no -- so a refusal is -EACCES.
        // AT_REMOVEDIR (v0.1.630 of the compiler): Mere's dir_remove; a refusal
        // with the directory still there is -ENOTEMPTY, the usual reason
        vec_set x 10 (if vec_get x 12 == 512 then
                        (if dir_remove (cstr_at mem (vec_get x 11)) == 0 then 0
                         else if file_exists (cstr_at mem (vec_get x 11)) then 0 - 39 else 0 - 2)
                      else if vec_get x 12 != 0 then 0 - 22
                      else if file_delete (cstr_at mem (vec_get x 11)) then 0
                      else if file_exists (cstr_at mem (vec_get x 11)) then 0 - 13 else 0 - 2)
      else if a7 == 278 then
        // buf is a0 and len is a1 -- NOT write()'s (fd, buf, len) shape one
        // line up. The first version copied that shape, filled zero bytes at
        // address four, and forty draws of random_int came back identical:
        // the property test caught an ABI transcription, not weak entropy.
        let buf = vec_get x 10 in
        let len = vec_get x 11 in
        let rec fill = fn i ->
          if i >= len then () else
            let _ = stb mem (mask32 (buf + i)) (random_int 256) in fill (i + 1) in
        let _ = fill 0 in
        vec_set x 10 len
      // An unknown syscall answers -ENOSYS, as Linux does. It used to fall
      // through silently -- a0 kept whatever it held, and a guest calling a
      // syscall this machine had not learned yet read its own argument back as
      // the result, which is a wrong answer with nobody's name on it.
      else vec_set x 10 (0 - 38)
  else if op == 0x57 || ((op == 0x07 || op == 0x27) && f3 == 0) then          // RVV subset
    vexec mem x st inst pc op f3 rd rs1 rs2 a
  else if op == 0x0F then ()                                          // FENCE -> nop
  else take_trap st 2 inst pc;                                        // illegal instruction

let rec run = fn mem -> fn x -> fn st -> fn budget ->
  if budget <= 0 then ()
  else if vec_get st 1 == 1 then ()
  else let _ = step mem x st in run mem x st (budget - 1);

// --- a tiny RV32I assembler (encoders mirror the imm_* decoders) ---------
let asm_r = fn f7 -> fn rs2 -> fn rs1 -> fn f3 -> fn rd -> fn op ->
  bit_or (bit_shl f7 25) (bit_or (bit_shl rs2 20) (bit_or (bit_shl rs1 15)
    (bit_or (bit_shl f3 12) (bit_or (bit_shl rd 7) op))));
let asm_i = fn imm -> fn rs1 -> fn f3 -> fn rd -> fn op ->
  bit_or (bit_shl (bit_and imm 4095) 20) (bit_or (bit_shl rs1 15)
    (bit_or (bit_shl f3 12) (bit_or (bit_shl rd 7) op)));
let asm_s = fn imm -> fn rs2 -> fn rs1 -> fn f3 -> fn op ->
  let i = bit_and imm 4095 in
  bit_or (bit_shl (bit_shr i 5) 25) (bit_or (bit_shl rs2 20) (bit_or (bit_shl rs1 15)
    (bit_or (bit_shl f3 12) (bit_or (bit_shl (bit_and i 31) 7) op))));
let asm_b = fn imm -> fn rs2 -> fn rs1 -> fn f3 -> fn op ->
  let i = bit_and imm 8191 in
  let b12 = bit_and (bit_shr i 12) 1 in
  let b11 = bit_and (bit_shr i 11) 1 in
  let b10_5 = bit_and (bit_shr i 5) 63 in
  let b4_1 = bit_and (bit_shr i 1) 15 in
  bit_or (bit_shl b12 31) (bit_or (bit_shl b10_5 25) (bit_or (bit_shl rs2 20) (bit_or (bit_shl rs1 15)
    (bit_or (bit_shl f3 12) (bit_or (bit_shl b4_1 8) (bit_or (bit_shl b11 7) op))))));
let asm_j = fn imm -> fn rd -> fn op ->
  let i = bit_and imm 2097151 in
  let b20 = bit_and (bit_shr i 20) 1 in
  let b19_12 = bit_and (bit_shr i 12) 255 in
  let b11 = bit_and (bit_shr i 11) 1 in
  let b10_1 = bit_and (bit_shr i 1) 1023 in
  bit_or (bit_shl b20 31) (bit_or (bit_shl b19_12 12) (bit_or (bit_shl b11 20)
    (bit_or (bit_shl b10_1 21) (bit_or (bit_shl rd 7) op))));

// --- run a real compiled program -----------------------------------------
// Load a flat binary (objcopy'd from a freestanding RV32I ELF) at address 0,
// set up the stack, and run from _start (PC=0) until the exit syscall.
// RAM size in MB, from the first argument (default 8). `mere -rv` lays its
// stack at the top of RAM, so the emulator has to be sized to match: plain
// `mere -rv` assumes 8 MB and `mere -rv --ram N` assumes N. 8 MB also leaves
// room for freestanding C (globals+heap at 2 MB, stack near the top).
let ram_mb = match args () with
  | Cons (a, _) -> int_of_str a
  | Nil -> 8;
let mem = new_vec (ram_mb * 1048576) 0;
let x = new_vec 32 0;
let st = new_vec 3 0;
let prog = read_file_bytes "prog.bin";
let pn = vec_len prog;
let rec load = fn i -> if i >= pn then () else let _ = stb mem (dram_base + i) (vec_get prog i) in load (i + 1);
let _ = load 0;
// A second image, if there is one, at 8 MB — the bootloader's job, done by the
// bootloader. A kernel with no filesystem has to get its first user process from
// somewhere, and `mere -rv --load-base 8388608` builds one to live here.
let user_base = dram_base + 8388608;   // 8 MB into RAM, wherever RAM starts
let _ =
  if file_exists "user.bin" then
    let u = read_file_bytes "user.bin" in
    let un = vec_len u in
    let rec loadu = fn i ->
      if i >= un then () else let _ = stb mem (user_base + i) (vec_get u i) in loadu (i + 1) in
    loadu 0
  else ();
// --- the argument block ---------------------------------------------------
// `rvrun <ram> [trace|virt] -- <args...>` hands the guest a command line. A
// guest built by `mere -rv` has no host to ask for one, so the loader leaves it
// in RAM at a place derived from the RAM size, exactly as that backend computes
// it: the last 24 KB, above the stack and the fantasy-console MMIO.
//
//   +0          magic "ARGV" -- without it the guest reads no arguments at all,
//               which is what keeps stale RAM from becoming a pointer
//   +4          count
//   +8 + 4*i    pointer to argument i, in the guest's own [len][bytes] layout
//   ...         the blocks
//
// This is the one place the loader has to agree with the compiler on an address,
// and it is wrong at a different `--ram` on either side -- the same requirement
// `mere -rv --ram N` already puts on the emulator's first argument.
let argv_base = dram_base + ram_mb * 1048576 - 0x6000;
let rec drop_to_sep = fn l ->
  match l with
  | Nil -> Nil
  | Cons (a, rest) -> if str_eq a "--" then rest else drop_to_sep rest;
let guest_args = drop_to_sep (args ());
let rec count_of = fn l -> match l with Nil -> 0 | Cons (_, r) -> 1 + count_of r;
let gn = count_of guest_args;
let stw = fn a -> fn v ->
  let _ = stb mem a v in
  let _ = stb mem (a + 1) (bit_shr v 8) in
  let _ = stb mem (a + 2) (bit_shr v 16) in
  stb mem (a + 3) (bit_shr v 24);
// Each block is [len][bytes], padded so the next one starts word-aligned --
// the guest loads the length with `lw`.
let rec put_str = fn at -> fn s ->
  let n = str_len s in
  let _ = stw at n in
  let rec bytes = fn i ->
    if i >= n then () else let _ = stb mem (at + 4 + i) (ord (char_at s i)) in bytes (i + 1) in
  let _ = bytes 0 in
  at + 4 + n + bit_and (4 - bit_and n 3) 3;
let _ =
  if gn == 0 then ()
  else
    let _ = stw argv_base 0x41524756 in            // "ARGV", as the compiler spells it
    let _ = stw (argv_base + 4) gn in
    let rec lay = fn i -> fn at -> fn l ->
      match l with
      | Nil -> ()
      | Cons (a, rest) ->
        let _ = stw (argv_base + 8 + i * 4) at in
        lay (i + 1) (put_str at a) rest in
    lay 0 (argv_base + 8 + gn * 4) guest_args;
// --- the environment block (v0.1.630 of the compiler reads it) ---------------
// 12 KB above the argument block's start, the second half of its 24 KB: magic
// "ENVP", the length, then the host's environment as `env -0` frames it --
// K=V and a NUL each, every field one 32-bit word. Whole variables that do not
// fit are left out.
let envp_base = argv_base + 0x3000;
let envp_room = 0x3000 - 8;
let _ =
  let e = env_pairs () in
  let rec fit = fn i -> fn last ->
    if i >= str_len e || i >= envp_room then last
    else if ord (char_at e i) == 0 then fit (i + 1) (i + 1)
    else fit (i + 1) last in
  let n = if str_len e <= envp_room then str_len e else fit 0 0 in
  let _ = stw envp_base 0x50564E45 in
  let _ = stw (envp_base + 4) n in
  let rec put = fn i -> if i >= n then () else let _ = stb mem (envp_base + 8 + i) (ord (char_at e i)) in put (i + 1) in
  put 0;

let _ = vec_set x 2 (dram_base + 0x70000);   // sp in RAM (the program also sets it)
let _ = vec_set st 0 dram_base;              // PC = the first byte of RAM = _start

// Run until the guest halts — an exit syscall, or an instruction the core does
// not implement. There is no instruction budget: the self-hosted Mere compiler
// needs well past the 100M this used to cap at, and a kernel-shaped guest never
// returns at all. Ctrl-C is the way out of a runaway guest.
// mtime advances once per instruction — a clock in units of work done, which is
// what a deterministic emulator can honestly offer. A timer interrupt is taken
// between instructions, the only point where the machine is in a consistent
// state to vector away from.
let csr_mie = 772;       // 0x304, bit 7 = MTIE
let csr_mip = 836;       // 0x344, bit 7 = MTIP
let timer_pending = fn () ->
  let armed = vec_get timer 1 in
  if armed == 0 then 0
  else if vec_get timer 0 < armed then 0
  else if bit_and (bit_shr (vec_get csr csr_mstatus) 3) 1 == 0 then 0   // MIE off
  else if bit_and (bit_shr (vec_get csr csr_mie) 7) 1 == 0 then 0       // MTIE off
  else 1;
// `rvrun <ram_mb> trace` reports where the guest is, every 100M instructions, on
// stderr. A guest that prints nothing for ten minutes gives no other clue: the
// halt reason only arrives when it halts, and a guest stuck in a loop never does.
// The pc can be read back to a symbol with the `S` lines of `mere -rvg`.
//
// Off by default, and off costs one comparison per instruction rather than the
// two vec operations the counter needs. mtime cannot serve as the counter: it is
// masked to 32 bits and the guest is allowed to write to it.
let trace = match args () with
  | Cons (_, Cons (b, _)) -> if str_eq b "trace" then 1 else 0
  | _ -> 0;
let _ = vec_set swon 0 trace;
// `watch <addr>` may follow the ram size (before `--`)
let rec find_watch = fn l ->
  match l with
  | Nil -> 0
  | Cons (a, rest) ->
    if str_eq a "--" then 0
    else if str_eq a "watch" then (match rest with Cons (n, _) -> int_of_str n | Nil -> 0)
    else find_watch rest;
let _ = vec_set watch_addr 0 (find_watch (args ()));
let rec find_abi = fn l ->
  match l with
  | Nil -> 0
  | Cons (s, rest) -> if str_eq s "abi" then 1 else find_abi rest;
let _ = vec_set abi_on 0 (find_abi (args ()));
let icount = new_vec 1 0;
let trace_every = 100000000;
// `mere -rv` grows its heap up in gp and its stack down in sp, and every
// allocation it emits checks `gp < sp` first. Nothing checked that the invariant
// still held BETWEEN allocations -- a guest that walked its stack pointer down
// past the heap top, or wrote past either end, went on running and produced
// wrong values a long way from the cause.
//
// x2 and x3 are sp and gp by that backend's convention, so the machine can watch
// it: under `trace`, the first instruction at which they cross stops the guest
// and says so. It is a report, not a rule -- a guest that is not from `mere -rv`
// may use these registers for anything, which is why it is off by default and
// lives with the tracing rather than in `step`.
let crossed = new_vec 1 0;
// The last 16 pc values, dumped when the guest halts under `trace`. A guest that
// trapped executing garbage tells you WHERE it died; what you need is where it
// CAME FROM -- the jump that went wrong is several instructions upstream, and
// nothing else records it.
let ring = new_vec 16 0;
let ringi = new_vec 1 0;


// The instruction loop MUST compile to a loop, not to recursion: its depth
// would otherwise be the emulated instruction count. Mere's C backend gives a
// single-argument top-level self-tail-call a `goto` since v0.1.402 -- before
// that it did not, and `drive` survived only because clang's sibling-call
// optimisation flattened it. That is not a property of a program: adding the
// openat/read/close service below was enough to change clang's mind, and every
// long-running guest then died with "stack overflow (recursion too deep)" --
// which reads as a fault in the guest, or in the compiler that produced it, and
// was neither. `drive` takes a counter it does not use so that it is a
// one-argument function of the shape the transform recognises.

let rec drive = fn (n: int) ->
  if vec_get st 1 == 1 then ()
  else
    let _ = vec_set timer 0 (mask32 (vec_get timer 0 + 1)) in
    let _ =
      if timer_pending () == 1 then
        let _ = vec_set csr csr_mip (bit_or (vec_get csr csr_mip) 128) in
        take_trap st 2147483655 0 (vec_get st 0)      // 0x80000007: machine timer
      else () in
    let _ =
      if trace == 1 then
        let n = vec_get icount 0 + 1 in
        let _ = vec_set icount 0 n in
        let gp = vec_get x 3 in
        let sp = vec_get x 2 in
        let _ =
          if gp >= sp && gp != 0 && vec_get crossed 0 == 0 then
            let _ = vec_set crossed 0 1 in
            let _ = print_err ("rvrun: heap and stack CROSSED at " ++ str_of_int n
                     ++ " insns, pc=" ++ str_of_int (vec_get st 0)
                     ++ " gp=" ++ str_of_int gp ++ " sp=" ++ str_of_int sp ++ "\n") in
            let _ = vec_set st 2 halt_crossed in
            vec_set st 1 1
          else () in
        let _ = vec_set ring (bit_and (vec_get ringi 0) 15) (vec_get st 0) in
        let _ = vec_set ringi 0 (vec_get ringi 0 + 1) in
        if n % trace_every == 0 then
          print_err ("rvrun: " ++ str_of_int n ++ " insns, pc=" ++ str_of_int (vec_get st 0)
                   ++ " gp=" ++ str_of_int gp ++ " sp=" ++ str_of_int sp
                   ++ " free=" ++ str_of_int (sp - gp) ++ "\n")
        else ()
      else () in
    if vec_get st 1 == 1 then () else let _ = step mem x st in drive (n + 1);
let _ = drive 0;
let _ = if vec_get abi_on 0 == 1 then
  print_err ("rvrun: ABI check: " ++ str_of_int (vec_get abi_hits 0)
             ++ " violation(s), " ++ str_of_int (vec_get abi_n 0) ++ " frame(s) still open\n")
else ();

// Under `trace`, say where the guest has just been -- oldest first. Only on an
// abnormal halt: a guest that exited on purpose has nothing to explain.
let _ =
  if trace == 1 && vec_get st 2 != halt_exit && vec_get st 2 != halt_finisher then
    let n0 = vec_get ringi 0 in
    let rec dump = fn i ->
      if i >= 16 then ()
      else
        let idx = bit_and (n0 + i) 15 in
        let _ = (if vec_get ring idx == 0 && i == 0 then () else
                 print_err ("rvrun: ring[" ++ str_of_int (i - 16) ++ "] pc=" ++ str_of_int (vec_get ring idx) ++ "\n")) in
        dump (i + 1) in
    let _ = dump 0 in
    let n1 = vec_get swi 0 in
    let rec sdump = fn i ->
      if i >= 8 then ()
      else
        let i3 = bit_and (n1 + i) 7 * 3 in
        let _ = (if vec_get swring i3 == 0 then () else
                 print_err ("rvrun: heapwrite pc=" ++ str_of_int (vec_get swring i3)
                   ++ " addr=" ++ str_of_int (vec_get swring (i3 + 1))
                   ++ " val=" ++ str_of_int (vec_get swring (i3 + 2)) ++ "\n")) in
        sdump (i + 1) in
    let _ = sdump 0 in
    // ...and the registers: ra names the caller, a0-a2 are the helper's
    // arguments, and a corrupt pointer among them is the thing to chase.
    let rec regs = fn i ->
      if i >= 32 then ()
      else
        let _ = (if vec_get x i == 0 then () else
                 print_err ("rvrun: x" ++ str_of_int i ++ " = " ++ str_of_int (vec_get x i) ++ "\n")) in
        regs (i + 1) in
    regs 1
  else ();

// The guest's output already went out as it was written, so there is nothing to
// flush here.
// and why it stopped, when that was not the guest asking. On stderr, so a gate
// comparing stdout against a reference is unaffected, and named rather than
// numbered: a silent halt and a finished program used to be the same event seen
// from here.
let why = vec_get st 2 in
let _ = if why == halt_exit then () else
  print_err ("rvrun: halted at pc=" ++ str_of_int (vec_get st 0) ++ " -- "
    ++ (if why == halt_mulh then "MULH/MULHSU/MULHU, which this core does not implement"
        else if why == halt_trap then "a trap with no handler installed"
        else if why == halt_finisher then "a write to the test finisher"
        else if why == halt_crossed then "the guest's heap top reached its stack (trace)"
        else "no reason recorded (a halt that predates this message)") ++ "\n");
// exit explicitly so the runtime doesn't echo this program's own final value
// after the emulated program's output.
// v0.1.637 of the compiler: with the status the guest's exit asked for (a
// failure exits 1, as it does on every other backend); a halt for any other
// reason ends 0, as it always has
exit (if why == halt_exit then vec_get guest_status 0 else 0)
